---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Chip Conference Deadlines" description="Tracker for analog/mixed-signal IC conference deadlines.">
  <style>
    .iframe-container {
      width: 100%;
      /* Adjust height to account for nav bar and viewport */
      height: calc(100vh - 60px); 
      margin: 0;
      padding: 0;
      overflow: hidden;
    }
    .deadlines-iframe {
      width: 100%;
      height: 100%;
      border: none;
      display: block;
    }
  </style>

  <div class="iframe-container">
    <iframe
      src="https://chennakeshavadasa.github.io/Conf_Deadline_Tracker/"
      class="deadlines-iframe"
      title="Chip Conference Deadlines Tracker"
      loading="lazy"
    ></iframe>
  </div>
</Layout>
