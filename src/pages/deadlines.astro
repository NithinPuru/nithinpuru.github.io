---
// Raw Astro page without Layout to avoid global CSS and nav bars
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Chip Conference Deadlines</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
    body, html {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden; /* Prevent double scrollbars */
    }
    .deadlines-iframe {
      width: 100%;
      height: 100%;
      border: none;
      display: block;
    }
  </style>
</head>
<body>
  <iframe
    src="https://chennakeshavadasa.github.io/Conf_Deadline_Tracker/"
    class="deadlines-iframe"
    title="Chip Conference Deadlines Tracker"
  ></iframe>
</body>
</html>
