---
import Layout from "../layouts/Layout.astro";
import ThemeToggle from "../components/ThemeToggle.astro";

const tools = "https://nithinpuru.com/#tools";
---
<Layout title="Page not found" description="This page does not exist." noindex>
  <div class="not-found">
    <p class="not-found__code">404</p>
    <h1>Page not found</h1>
    <p class="not-found__text">The page you were looking for does not exist on this site.</p>
    <a class="not-found__link" href={tools}>All tools</a>
    <div><ThemeToggle /></div>
  </div>
</Layout>
