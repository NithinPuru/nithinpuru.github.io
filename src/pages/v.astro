---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="v"
  description=""
  noindex={true}
>
  <style>
    .v-wrap {
      max-width: 860px;
      margin: 3rem auto;
      padding: 0 1.5rem;
      font-family: var(--font-serif);
    }
    .v-title {
      font-size: 0.75rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--ink-3);
      font-family: var(--font-mono);
      margin-bottom: 2rem;
    }
    .v-iframe {
      width: 100%;
      height: 560px;
      border: 1px solid var(--rule);
      display: block;
    }
    .v-meta {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--ink-3);
      margin-top: 0.8rem;
    }
  </style>

  <div class="v-wrap">
    <p class="v-title">nithinpuru.github.io - visitor statistics</p>
    <iframe
      src="/visitor.html"
      class="v-iframe"
      title="Visitor statistics"
      loading="lazy"
    ></iframe>
    <p class="v-meta" id="v-meta">-</p>
  </div>

  <script is:inline>
    // Load last update timestamp from visitor_last_update.json
    fetch('/visitor_last_update.json')
      .then(function(r){ return r.json(); })
      .then(function(d){
        var el = document.getElementById('v-meta');
        if (el) el.textContent =
          'Total visitors: ' + d.total_visitors.toLocaleString() +
          '  ·  Last updated: ' + d.last_update;
      })
      .catch(function(){});
  </script>
</Layout>
