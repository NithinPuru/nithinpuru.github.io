---
// Renders the nbconvert (JupyterLab) export of the Ron/gm methodology
// notebook as a real route (/notebook) instead of a static .html file.
// The export is a complete HTML document; we re-slice it into head + body
// so Astro can serve it, and theme the body background to the site paper.
import notebookRaw from "../data/notebook.html?raw";

const headOpen = notebookRaw.indexOf("<head>");
const headClose = notebookRaw.indexOf("</head>");
const bodyTagStart = notebookRaw.indexOf("<body");
const bodyTagEnd = notebookRaw.indexOf(">", bodyTagStart);
const bodyClose = notebookRaw.indexOf("</body>");

const headContent = notebookRaw.slice(headOpen + 6, headClose).replace(
  /<title>.*?<\/title>/,
  "<title>Wrøngm — Ron/gm Design Methodology</title>",
);
const bodyContent = notebookRaw.slice(bodyTagEnd + 1, bodyClose);
---
<html lang="en">
  <head>
    {/** @ts-expect-error headContent is intentionally raw HTML from the export */}
    <Fragment set:html={headContent} />
    <style is:inline>
      html,
      body {
        margin: 0;
        padding: 0;
      }
      body.jp-Notebook {
        --jp-layout-color0: #faf9f4;
        --jp-layout-color1: #faf9f4;
        --jp-notebook-padding: 0px;
        margin: 0;
        padding: 0;
        background: #faf9f4;
      }
      body.jp-Notebook main {
        margin: 0;
        padding: 20px 0;
      }
    </style>
  </head>
  <body class="jp-Notebook" data-jp-theme-light="true" data-jp-theme-name="JupyterLab Light">
    {/** @ts-expect-error bodyContent is intentionally raw HTML from the export */}
    <Fragment set:html={bodyContent} />
  </body>
</html>
