---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const notebookParam = encodeURIComponent('Wrøngm.ipynb');
const colabUrl = 'https://colab.research.google.com/drive/1q6r7tg8RoyLBaMS3b7EONwkPCBzEM2c1?usp=sharing';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ron/gm Notebook — Nithin Purushothama</title>
    <style>
      *, *::before, *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html, body {
        height: 100%;
        overflow: hidden;
      }

      body {
        display: flex;
        flex-direction: column;
        font-family: 'Courier New', monospace;
        background: #faf9f6;
      }

      .nb-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.6rem 1.5rem;
        background: #faf9f6;
        border-bottom: 1px solid #ddd;
        font-size: 0.75rem;
        letter-spacing: 0.05em;
        flex-shrink: 0;        /* bar never shrinks */
      }

      .nb-bar a {
        text-decoration: none;
        text-transform: uppercase;
        color: #111;
      }

      .nb-actions {
        display: flex;
        gap: 0.75rem;
        align-items: center;
      }

      .btn {
        border: 1px solid #111;
        padding: 0.3rem 0.85rem;
        font-size: 0.75rem;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        text-decoration: none;
        color: #111;
        font-family: inherit;
      }

      .btn:hover {
        background: #111;
        color: #faf9f6;
      }

      .nb-note {
        font-size: 0.7rem;
        color: #666;
        letter-spacing: 0.03em;
      }

      iframe {
        flex: 1 1 0;     /* grow, shrink, basis 0 */
        min-height: 0;   /* CRITICAL — without this flex children can't shrink */
        width: 100%;
        border: none;
        display: block;
      }
    </style>
  </head>
  <body>
    <div class="nb-bar">
      <a href={`${base}/`}>← Back</a>
      <div class="nb-actions">
        <span class="nb-note">Run cells directly below ↓</span>
        <a href={colabUrl} target="_blank" rel="noopener noreferrer" class="btn">
          Open in Colab ↗
        </a>
      </div>
    </div>
    <iframe
      src={`${base}/lab/index.html?path=${notebookParam}`}
      title="Ron/gm Design Methodology — Interactive Notebook"
      allow="cross-origin-isolated"
    ></iframe>
  </body>
</html>
