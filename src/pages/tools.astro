---
// Tools index: every tool in src/data/tools.json. Each tool's "home" link
// points here (the site root forwards to the portfolio on nithinpuru.com).
import Layout from "../layouts/Layout.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import tools from "../data/tools.json";

const entries = tools.groups.flatMap((g) => g.entries);
const isExternal = (url: string) => /^https?:\/\//.test(url);
---
<Layout
  title="Browser tools - gm/ID, quant terminals, research radar"
  description="Browser-based tools for analog IC design, research and finance: gm/ID explorer for open PDKs, semiconductor and FX quant terminals, a research radar and a conference deadline tracker."
>
  <header class="head">
    <h1>Tools</h1>
    <ThemeToggle />
  </header>
  <p class="lede">
    Browser-based tools for analog IC design, research and finance. Everything
    runs in your browser; the data-driven tools are refreshed by scheduled bots.
  </p>
  <ol class="tools">
    {entries.map((entry, i) => (
      <li class="tool">
        <span class="tool__no" aria-hidden="true">{i + 1}</span>
        <div>
          <h2 class="tool__title"><a href={entry.url}>{entry.title}</a></h2>
          {entry.meta && <p class="tool__meta">{entry.meta}</p>}
          <p class="tool__desc" set:html={entry.desc} />
          {entry.links?.some((l) => l.url !== entry.url) && (
            <ul class="tool__links">
              {entry.links.filter((l) => l.url !== entry.url).map((l) => (
                <li>
                  {isExternal(l.url) ? (
                    <a href={l.url} target="_blank" rel="noopener noreferrer">
                      {l.label}
                      <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" /></svg>
                    </a>
                  ) : (
                    <a href={l.url}>{l.label}</a>
                  )}
                </li>
              ))}
            </ul>
          )}
        </div>
      </li>
    ))}
  </ol>
</Layout>
