---

import WorkList from "../components/WorkList.astro";
import Icon from "../components/Icon.astro";
import Layout from "../layouts/Layout.astro";

// Data hygiene: re-verify src/data/*.json when updating content.
import projects from "../data/projects.json";
import publications from "../data/publications.json";
import finance from "../data/finance.json";

const github = "https://github.com/chennakeshavadasa";
const linkedin = "https://www.linkedin.com/in/nithin-purushothama-70664727b/";
const email = "nithinpurushothama@gmail.com";

---
<Layout>
  <div class="sheet">
    <header class="masthead" id="about">
      <div class="masthead__grid">


        <div class="masthead__head">
          <h1>Nithin Purushothama</h1>

          <p class="doc-meta">
            <span>Analog &middot; Mixed-Signal IC Designer</span>
          </p>
        </div>

        <div class="abstract">
          <span class="ab-label">About me</span>
          <p>
            I am an Analog/Mixed-Signal IC Designer with hands-on experience in circuit design across 28&nbsp;nm–180&nbsp;nm technologies, including tapeout experience with open-source PDKs such as SKY130, GF180MCU, and IHP SG13G2 (130&nbsp;nm BiCMOS). I worked as a Research Intern at the <a href="https://sites.google.com/iitgn.ac.in/madhav-pathak" target="_blank" rel="noopener noreferrer">LP-CAS (Low-Power Circuits and Systems) Lab</a>, IIT Gandhinagar, under the guidance of <a href="https://iitgn.ac.in/faculty/ee/fac-madhav" target="_blank" rel="noopener noreferrer">Prof. Madhav K. Pathak</a>, where I worked on ring amplifiers and their applications in low-power LDOs. I am currently working in industry on PVT Monitor and Reference IPs in 28&nbsp;nm CMOS.
          </p>

          <p>
            These experiences have helped me develop a strong interest in energy-efficient circuit design, research-driven problem solving, and translating circuit-level ideas into practical systems and applications.
          </p>

          <span class="ab-label" style="margin-top: 1.8rem;">Research Interests</span>
          <ol class="abstract-list">
            <li>High-speed and low-power data converters</li>
            <li>Biomedical circuits, wearable sensing, and healthcare SoCs</li>
            <li>Dynamic amplifiers and ring amplifiers</li>
            <li>Circuits for AI and AI for circuits</li>
            <li>Analog circuits for neural-network computation, sensing, and signal processing</li>
            <li>Algorithm–circuit co-design for low-power sensing and computation</li>
            <li>Emerging computing architectures, including in-memory computing and other non-traditional computing paradigms, with a focus on circuit-level implementations</li>
            <li>Open-source IC design and EDA methodologies</li>
          </ol>

          <p>
            I am particularly interested in energy-efficient analog and mixed-signal circuits for sensing, computation, and data conversion, as well as the co-design of circuits, algorithms, and emerging computing architectures. I am also interested in open and reproducible approaches to IC design, spanning circuit design, simulation, physical implementation, and EDA.
          </p>

          <p>
            I hope to develop practical and impactful circuit and system-level technologies that can translate into real-world benefits. I am particularly motivated by applications where integrated circuits can contribute to healthcare, medical treatment and therapy, sensing, and assistive technologies, ultimately helping improve people's lives.
          </p>

          <p>
            Outside of circuit design, my primary interests lie in macroeconomics and data-driven quantitative analysis of businesses and financial markets, particularly the use of machine learning and large-scale economic and financial datasets to study economic trends, business decisions, and investment opportunities.
          </p>

          <p>
            I am also an IEEE SSCS Code-a-Chip Travel Grant Awardee for ESSERC 2026, where I will be presenting my work on <i>R<sub>on</sub>/G<sub>m</sub></i> based design methodology for dynamic amplifiers.
          </p>
        </div>

        <a class="btn btn--ghost" href="#contact">
          Get in touch
          <span class="btn__arrow" aria-hidden="true">
            <Icon name="down" />
          </span>
        </a>
      </div>
    </header>

    <section class="section" id="experience" aria-labelledby="experience-h">
      <header class="section-head" data-reveal>
        <h2 class="section-title" id="experience-h">Experience</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </header>

      <ul class="cv-highlights" data-reveal>
        <li>
          <span class="k" style="font-family: var(--font-serif); font-size: 1.125rem; letter-spacing: 0; text-transform: none; color: var(--ink);">
            <strong>Omni Design Technologies</strong>
            <span class="mono" style="display: block; margin-top: 0.3rem; font-size: 0.85rem; color: var(--ink-3); text-transform: none; letter-spacing: 0;">
              Bengaluru, India<br/>March 2026 – Present
            </span>
          </span>
          <span>
            <strong style="font-size: 1.125rem; color: var(--ink);">Analog Design Intern</strong><br />
            <div style="margin-top: 0.4rem; color: var(--ink-2); line-height: 1.5;">
              <strong>◦ Block Designs:</strong> Designed the Bandgap Core and Reference Analog blocks for the PVT Monitor and Reference IPs in TSMC 28 nm CMOS.
              <ul style="margin: 0.3rem 0 0 1rem; padding: 0; list-style-type: '♦ '; display: flex; flex-direction: column; gap: 0.25rem;">
                <li>Replaced the BG CORE opamp with a self-biased folded-cascode OTA and a new always-on startup circuit, fixing a common-mode bug that latched the bandgap loop at VDD; reduced 8-bit I-DAC current mismatch to downstream SC-amp and ADC blocks.</li>
                <li>Owned REF ANALOG: 5 temperature-compensated high-PSRR reference voltages and 8×200 μA current, adding trim-based programmability to compensate for process and mismatch to meet the ±3% output accuracy specification.</li>
                <li>Mapped digital infrastructure from a 16 nm reference IP onto the redesigned 28 nm blocks, enabling block-level reuse and accelerating IP closure.</li>
              </ul>
            </div>
          </span>
        </li>
        <li>
          <span class="k" style="font-family: var(--font-serif); font-size: 1.125rem; letter-spacing: 0; text-transform: none; color: var(--ink);">
            <strong>PhyTau Semiconductors</strong>
            <span class="mono" style="display: block; margin-top: 0.3rem; font-size: 0.85rem; color: var(--ink-3); text-transform: none; letter-spacing: 0;">
              Bengaluru, India<br/>Oct 2025 – Feb 2026
            </span>
          </span>
          <span>
            <strong style="font-size: 1.125rem; color: var(--ink);">Analog Design Engineer</strong><br />
            <div style="margin-top: 0.4rem; color: var(--ink-2); line-height: 1.5;">
              <strong>◦ Block Designs:</strong> Designed a 4-input PWM comparator with programmable hysteresis for a multi-phase DC-DC converter SoC in UMC 55 nm CMOS.
              <ul style="margin: 0.3rem 0 0 1rem; padding: 0; list-style-type: '♦ '; display: flex; flex-direction: column; gap: 0.25rem;">
                <li>Redesigned the comparator to introduce programmable hysteresis at the first stage, eliminating trip-point glitches and reducing propagation delay; reduced power consumption by 30%.</li>
                <li>Debugged digital-induced glitches, identifying delay contributions from hysteresis control and de-glitching logic.</li>
              </ul>
            </div>
          </span>
        </li>
        <li>
          <span class="k" style="font-family: var(--font-serif); font-size: 1.125rem; letter-spacing: 0; text-transform: none; color: var(--ink);">
            <strong>Indian Institute of Technology Gandhinagar (IITGN)</strong>
            <span class="mono" style="display: block; margin-top: 0.3rem; font-size: 0.85rem; color: var(--ink-3); text-transform: none; letter-spacing: 0;">
              Gandhinagar, India<br/>Aug 2024 – Aug 2025 (Hybrid, In-person from Feb 2025)
            </span>
          </span>
          <span>
            <strong style="font-size: 1.125rem; color: var(--ink);">Research Intern</strong> (Advisor: Prof. Madhav K. Pathak, LP-CAS Lab)<br />
            <div style="margin-top: 0.4rem; color: var(--ink-2); line-height: 1.5;">
              <strong>◦ Block Designs:</strong> Dynamic Amplifiers and Ring Amplifier-based LDO at LP-CAS Lab, IITGN.
              <ul style="margin: 0.3rem 0 0.6rem 1rem; padding: 0; list-style-type: '♦ '; display: flex; flex-direction: column; gap: 0.25rem;">
                <li>Developed a design methodology for non-linear dynamic amplifiers modelling RC, large-signal, and small-signal settling stages; validated on an inverter-based switched-capacitor amplifier. (Published at ESSERC 2026.)</li>
                <li>Proposed a Ring Amplifier-based LDO where the final stage serves as the pass transistor, using adaptive biasing and a deadzone regulation circuit for robust PVT performance.</li>
                <li>Proposed a translinear circuit-based MAC architecture for analog neural networks using a digitally controlled subthreshold MOSFET cell with a current-steering DAC for programmable neuron weights.</li>
                <li>Served as Teaching Assistant for the IIT Gandhinagar graduate course PMIC Design (EE660).</li>
              </ul>
              <strong>◦ Tapeout §:</strong> Designed a piecewise-compensated, high-PSRR Bandgap Reference with sub-5 ppm/°C TC in SKY130, including a low-power always-on startup circuit; fabricated through the TinyTapeout SKY130 shuttle.
            </div>
          </span>
        </li>
        <li>
          <span class="k" style="font-family: var(--font-serif); font-size: 1.125rem; letter-spacing: 0; text-transform: none; color: var(--ink);">
            <strong>Indian Space Research Organisation (ISRO)</strong>
            <span class="mono" style="display: block; margin-top: 0.3rem; font-size: 0.85rem; color: var(--ink-3); text-transform: none; letter-spacing: 0;">
              Hassan, India<br/>Oct 2023 – Nov 2023
            </span>
          </span>
          <span>
            <strong style="font-size: 1.125rem; color: var(--ink);">Intern</strong><br />
            <div style="margin-top: 0.4rem; color: var(--ink-2); line-height: 1.5;">
              <strong>◦ Project:</strong> GeoSat-based satellite communication in the Antenna System for Satellite TTC within C-Band (6 GHz) at the Baseband RF Division, Master Control Facility. Calibrated antenna systems to achieve Cross-Polar Discrimination (XPD) during In-Orbit Testing of GSAT-31.
            </div>
          </span>
        </li>
      </ul>
    </section>

    <section class="section" id="education" aria-labelledby="education-h">
      <header class="section-head" data-reveal>
        <h2 class="section-title" id="education-h">Education</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </header>

      <ul class="cv-highlights" data-reveal>
        <li>
          <span class="k" style="font-family: var(--font-serif); font-size: 1.125rem; letter-spacing: 0; text-transform: none; color: var(--ink);">
            <strong>Visvesvaraya Technological University</strong>
            <span class="mono" style="display: block; margin-top: 0.3rem; font-size: 0.85rem; color: var(--ink-3); text-transform: none; letter-spacing: 0;">
              Bengaluru, India<br/>December 2021 – June 2025
            </span>
          </span>
          <span>
            <strong style="font-size: 1.125rem; font-weight: 600; color: var(--ink);">Bachelor of Engineering - Electronics and Communication Engineering</strong><br />
            <span style="color: var(--ink-2);">CGPA: 8.6 / 10</span><br />
            <span style="display: block; margin-top: 0.4rem; color: var(--ink-2); line-height: 1.5;">
              Courses taken: Signals and systems, Control systems, Circuit theory, Analog electronics, Analog and digital communication, Digital signal processing, Microprocessor and microcontrollers, Microwave and antenna theory, CMOS VLSI design, Optical and wireless communication.
            </span>
          </span>
        </li>
      </ul>
    </section>

    <section class="section" id="publications" aria-labelledby="publications-h">
      <header class="section-head" data-reveal>
        <h2 class="section-title" id="publications-h">Publications</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </header>
      <p class="section-lede" data-reveal>
        Conference papers.
      </p>

      <WorkList groups={publications.groups} />
    </section>

    <section class="section" id="awards" aria-labelledby="awards-h">
      <header class="section-head" data-reveal>
        <h2 class="section-title" id="awards-h">Awards</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </header>

      <ul class="cv-highlights" data-reveal>
        <li>
          <span class="k" style="font-size: 0.85rem; line-height: 1.3; text-transform: none;">IEEE SSCS &ldquo;Code-a-Chip&rdquo; Travel Grant Award 2026</span>
          <span style="display: flex; flex-direction: column; gap: 0.3rem;">
            <a href="https://github.com/sscs-ose/sscs-ose-code-a-chip.github.io" target="_blank" rel="noopener noreferrer" style="font-size: 1.05rem; font-weight: 600; color: var(--ink-1); text-decoration: underline;">IEEE SSCS &ldquo;Code-a-Chip&rdquo; Travel Grant Award 2026</a>
            <span class="mono">IEEE Solid-State Circuits Society (SSCS) &ndash; Open-Source Ecosystem (TC-OSE)</span>
            <span>
              Awarded $5,000 travel grant (Young Professional&rsquo;s category) for &ldquo;Ron/gm Based Design Methodology for Dynamic Amplifiers&rdquo; a notebook demonstrating a novel design methodology for Inverter-based dynamic amplifiers on IHP SG13G2 using open-source EDA tools. Award ceremony at ESSERC 2026, Palma de Mallorca, Spain.
            </span>
          </span>
        </li>
      </ul>
    </section>

    <section class="section" id="projects" aria-labelledby="projects-h">
      <header class="section-head" data-reveal>
        <h2 class="section-title" id="projects-h">Projects</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </header>
      <p class="section-lede" data-reveal>
        Tapeouts, analog blocks, and open-source EDA tooling - every entry links to the real artifact.
      </p>

      <WorkList groups={projects.groups} />

      <p class="section-foot" data-reveal>
        More on <a href={`${github}?tab=repositories`} target="_blank" rel="noopener noreferrer">GitHub</a>.
      </p>
    </section>


    <section class="section" id="finance" aria-labelledby="finance-h">
      <header class="section-head" data-reveal>
        <h2 class="section-title" id="finance-h">Quantitative Finance</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </header>

      <WorkList groups={finance.groups} />
    </section>

    <section class="section" id="cv" aria-labelledby="cv-h">
      <header class="section-head" data-reveal>
        <h2 class="section-title" id="cv-h">Curriculum Vitae</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </header>

      <div class="cv-embed-wrap" data-reveal>
        <iframe
          src="https://drive.google.com/file/d/1aR6vUMm0HdG_8t8vji6kfRkIFi19ts4v/preview"
          class="cv-embed"
          allow="autoplay"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Nithin Purushothama - CV"
        ></iframe>
        <a
          href="https://drive.google.com/file/d/1aR6vUMm0HdG_8t8vji6kfRkIFi19ts4v/view?usp=sharing"
          target="_blank"
          rel="noopener noreferrer"
          class="cv-open-link mono"
        >
          Open full CV
          <span class="btn__arrow" aria-hidden="true">
            <Icon name="external" />
          </span>
        </a>
      </div>
    </section>

    <section class="section" id="contact" aria-labelledby="contact-h">
      <header class="section-head" data-reveal>
        <h2 class="section-title" id="contact-h">Contact</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </header>

      <div data-reveal>
        <div class="contact-row">
          <span class="k">Email</span>
          <a href={`mailto:${email}`}>{email}</a>
        </div>
        <div class="contact-row">
          <span class="k">GitHub</span>
          <a href={github} target="_blank" rel="noopener noreferrer">github.com/chennakeshavadasa</a>
        </div>
        <div class="contact-row">
          <span class="k">LinkedIn</span>
          <a href={linkedin} target="_blank" rel="noopener noreferrer">linkedin.com/in/nithin-purushothama-70664727b</a>
        </div>
      </div>
    </section>

    <div class="site-footer" role="contentinfo">
      <span>Typeset in Computer Modern</span>
      <span aria-hidden="true">·</span>
      <span>&copy; 2026 Nithin Purushothama</span>
      <span aria-hidden="true">·</span>
      <a href={github} target="_blank" rel="noopener noreferrer">GitHub</a>
      <span aria-hidden="true">·</span>
      <a href={linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </div>
  </div>
</Layout>
