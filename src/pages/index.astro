---
import { existsSync } from "node:fs";
import WorkList from "../components/WorkList.astro";
import Icon from "../components/Icon.astro";
import Layout from "../layouts/Layout.astro";

// Data hygiene: star counts and repo totals below are supplied truth that
// goes stale as the GitHub accounts evolve. Re-verify src/data/*.json when
// updating content.
import projects from "../data/projects.json";
import publications from "../data/publications.json";
import finance from "../data/finance.json";

const github = "https://github.com/chennakeshavadasa";
const linkedin = "https://www.linkedin.com/in/nithin-purushothama-70664727b/";
const email = "nithinpurushothama@gmail.com";

// Resolves a public/ asset path against the configured base ("/") locally,
// "/repo/" on a GitHub Pages project site).
const asset = (p) =>
  `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${p.replace(/^\//, "")}`;

// Portrait: drop public/portrait.jpg (or portrait.png) to replace the
// placeholder frame. It is served at /portrait.jpg (or /portrait.png).
const portrait = existsSync("public/portrait.jpg")
  ? asset("portrait.jpg")
  : existsSync("public/portrait.png")
    ? asset("portrait.png")
    : null;
---
<Layout>
  <div class="sheet">
    <header class="masthead" id="about">
      <svg class="masthead__trace" viewBox="0 0 720 26" preserveAspectRatio="none" fill="none" aria-hidden="true">
        <path
          d="M0 13 L720 13"
          pathLength="100"
          stroke="currentColor"
          stroke-width="1"
          vector-effect="non-scaling-stroke"
          stroke-linecap="square"
        />
      </svg>

      <div class="masthead__grid">
        <figure class="portrait">
          {
            portrait ? (
              <img src={portrait} alt="Portrait of Nithin Purushothama" width="720" height="900" />
            ) : (
              <span class="portrait__placeholder">portrait</span>
            )
          }
          <figcaption class="mono">Fig. 1 &mdash; Portrait</figcaption>
        </figure>

        <div class="masthead__head">
          <h1>Nithin&nbsp;Purushothama</h1>

          <p class="doc-meta">
            <span>Analog &middot; Mixed-Signal IC Designer</span>
          </p>
        </div>

        <div class="abstract">
          <span class="ab-label">Abstract</span>
          <p>
            Analog/Mixed-Signal IC designer with tapeout experience across SKY130, GF180MCU, IHP SG13G2,
            UMC 55&nbsp;nm, and TSMC 28&nbsp;nm nodes. Research background from the LP-CAS Lab at IIT Gandhinagar
            (advisor: Prof. Madhav K. Pathak), with ongoing industry work on PVT Monitor and Reference IPs
            at Omni Design Technologies. IEEE SSCS Code-a-Chip Travel Grant awardee (ESSERC 2026).
            Research interests span dynamic amplifiers, voltage references, LDOs, and analog neural network
            primitives. A parallel interest in quantitative finance drives open-source semiconductor equity
            analysis tools.
          </p>
        </div>

        <a class="btn btn--ghost" href="#contact">
          Get in touch
          <span class="btn__arrow" aria-hidden="true">
            <Icon name="down" />
          </span>
        </a>
      </div>
    </header>

    <section class="section" id="experience" aria-labelledby="experience-h">
      <header class="section-head" data-reveal>
        <span class="section-no" aria-hidden="true">2</span>
        <h2 class="section-title" id="experience-h">Experience</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </header>

      <ul class="cv-highlights" data-reveal>
        <li>
          <span class="k">Omni Design Technologies</span>
          <span>
            <span class="mono" style="font-size:0.76rem">Bengaluru, India · Analog Design Intern · March 2026 – Present</span><br />
            Designing Bandgap Core and Reference Analog blocks for PVT Monitor and Reference IPs in TSMC 28&nbsp;nm CMOS.
            Replaced BG CORE opamp with a self-biased folded-cascode OTA and always-on startup circuit, fixing a common-mode latch bug.
            Owns REF ANALOG: 5 temperature-compensated high-PSRR reference voltages and an 8&times;200&nbsp;&mu;A current reference
            with trim-based programmability achieving &plusmn;20&nbsp;ppm/&deg;C drift.
          </span>
        </li>
        <li>
          <span class="k">PhyTau Semiconductors</span>
          <span>
            <span class="mono" style="font-size:0.76rem">Bengaluru, India · Analog Design Engineer · October 2025 – February 2026</span><br />
            Worked on a 4-input PWM comparator with hysteresis for a multi-phase DC-DC converter SoC in UMC 55&nbsp;nm CMOS.
            Redesigned comparator to introduce programmable hysteresis at the first stage, eliminating trip-point glitches and
            reducing propagation delay; reduced power consumption by 30%.
          </span>
        </li>
        <li>
          <span class="k">IIT Gandhinagar — LP-CAS Lab</span>
          <span>
            <span class="mono" style="font-size:0.76rem">Gandhinagar, India · Research Intern (Advisor: Prof. Madhav K. Pathak) · February 2025 – August 2025</span><br />
            Developed Ron/gm-based design methodology for non-linear dynamic amplifiers; proposed a Ring Amplifier LDO architecture;
            proposed a translinear MAC architecture for analog neural networks using digitally controlled subthreshold MOSFET cells.
            Teaching Assistant for graduate course PMIC Design (EE660).
            Tapeout: sub-5&nbsp;ppm/&deg;C bandgap reference in SKY130 through TinyTapeout 10.
          </span>
        </li>
        <li>
          <span class="k">ISRO — Master Control Facility</span>
          <span>
            <span class="mono" style="font-size:0.76rem">P Hassan, India · Intern · October 2023 – November 2023</span><br />
            GeoSat-based satellite communication in the Antenna System for Satellite TTC within C-Band (6&nbsp;GHz)
            at the Baseband RF Division, Master Control Facility. Calibrated antenna systems to achieve
            Cross-Polar Discrimination (XPD) during In-Orbit Testing of GSAT-31.
          </span>
        </li>
      </ul>
    </section>

    <section class="section" id="education" aria-labelledby="education-h">
      <header class="section-head" data-reveal>
        <span class="section-no" aria-hidden="true">3</span>
        <h2 class="section-title" id="education-h">Education</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </header>

      <ul class="cv-highlights" data-reveal>
        <li>
          <span class="k">Visvesvaraya Technological University</span>
          <span>
            <span class="mono" style="font-size:0.76rem">Bengaluru, India · December 2021 – June 2025</span><br />
            Bachelor of Engineering — Electronics and Communication Engineering<br />
            CGPA: 8.6 / 10
          </span>
        </li>
      </ul>
    </section>

    <section class="section" id="awards" aria-labelledby="awards-h">
      <header class="section-head" data-reveal>
        <span class="section-no" aria-hidden="true">4</span>
        <h2 class="section-title" id="awards-h">Awards</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </header>

      <ul class="cv-highlights" data-reveal>
        <li>
          <span class="k">IEEE SSCS &ldquo;Code-a-Chip&rdquo; Travel Grant — 2026</span>
          <span>
            <span class="mono" style="font-size:0.76rem">IEEE Solid-State Circuits Society (SSCS) — Open-Source Ecosystem (TC-OSE)</span><br />
            Awarded $5,000 travel grant (Young Professional&rsquo;s category) for &ldquo;Ron/gm Based Design Methodology for
            Dynamic Amplifiers&rdquo; &mdash; a notebook demonstrating a novel design methodology for inverter-based dynamic
            amplifiers on IHP SG13G2 using open-source EDA tools. Presented at ESSERC 2026, Palma de Mallorca, Spain.
          </span>
        </li>
      </ul>
    </section>

    <section class="section" id="skills" aria-labelledby="skills-h">
      <header class="section-head" data-reveal>
        <span class="section-no" aria-hidden="true">5</span>
        <h2 class="section-title" id="skills-h">Skills</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </header>

      <ul class="cv-highlights" data-reveal>
        <li>
          <span class="k">Core Skills</span>
          <span>Analog IC Design, Switched-Capacitor Amplifiers, Ring Amplifiers, LDOs, BGRs, OTAs, CMOS Circuit Design, Tapeout (DRC, LVS, PEX), Mixed-Signal Simulation</span>
        </li>
        <li>
          <span class="k">EDA Tools</span>
          <span>Cadence Virtuoso/Spectre, NGSpice, Xschem, Magic VLSI, KLayout, Netgen, LTspice, Keysight ADS</span>
        </li>
        <li>
          <span class="k">PDKs</span>
          <span>TSMC 28&nbsp;nm, UMC 55&nbsp;nm, IHP SG13G2 (BiCMOS), SKY130, GF180MCU</span>
        </li>
        <li>
          <span class="k">Languages</span>
          <span>Python, MATLAB, C/C++, Verilog, SystemVerilog, OCEAN Script, NGSpice Control Language, LaTeX</span>
        </li>
        <li>
          <span class="k">ML &amp; Quant</span>
          <span>NumPy, Pandas, SciPy, Scikit-learn, PyTorch (basics); Financial modelling, Monte Carlo simulation, Time-series analysis (ARIMA, Holt-Winters), Risk metrics (VaR, CVaR, Sharpe/Sortino)</span>
        </li>
      </ul>
    </section>

    <section class="section" id="work" aria-labelledby="work-h">
      <header class="section-head" data-reveal>
        <span class="section-no" aria-hidden="true">6</span>
        <h2 class="section-title" id="work-h">Selected Work</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </header>
      <p class="section-lede" data-reveal>
        A curated catalogue of what I have designed and built &mdash; tapeouts,
        analog blocks, and open-source EDA tooling. Every entry is a real artifact.
      </p>

      <WorkList groups={projects.groups} />

      <p class="section-foot" data-reveal>
        The full catalogue lives on{" "}
        <a href={`${github}?tab=repositories`}>GitHub</a>.
      </p>
    </section>

    <section class="section" id="publications" aria-labelledby="publications-h">
      <header class="section-head" data-reveal>
        <span class="section-no" aria-hidden="true">7</span>
        <h2 class="section-title" id="publications-h">Publications</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </header>
      <p class="section-lede" data-reveal>
        Peer-reviewed conference papers. New entries drop in without touching
        markup &mdash; this section is plain JSON.
      </p>

      <WorkList groups={publications.groups} />
    </section>

    <section class="section" id="finance" aria-labelledby="finance-h">
      <header class="section-head" data-reveal>
        <span class="section-no" aria-hidden="true">8</span>
        <h2 class="section-title" id="finance-h">Quantitative Finance</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </header>
      <p class="section-lede" data-reveal>
        A parallel interest in quantitative finance drives open-source semiconductor
        equity analysis tools and methodology work.
      </p>

      <WorkList groups={finance.groups} />
    </section>

    <section class="section" id="cv" aria-labelledby="cv-h">
      <header class="section-head" data-reveal>
        <span class="section-no" aria-hidden="true">9</span>
        <h2 class="section-title" id="cv-h">Curriculum Vitae</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </header>

      <div class="cv-frame" data-reveal>
        <!-- CV delivery: drop cv.pdf into public/ so it is served at /cv.pdf (this button already targets it). -->
        <p>
          A typeset CV, kept current with the work on this page.
        </p>
        <a class="btn btn--solid" href={asset("cv.pdf")} target="_blank" rel="noopener noreferrer">
          <Icon name="down" />
          Open CV (.pdf)
        </a>
      </div>
    </section>

    <section class="section" id="contact" aria-labelledby="contact-h">
      <header class="section-head" data-reveal>
        <span class="section-no" aria-hidden="true">10</span>
        <h2 class="section-title" id="contact-h">Contact</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </header>

      <div data-reveal>
        <div class="contact-row">
          <span class="k">Email</span>
          <a href={`mailto:${email}`}>{email}</a>
        </div>
        <div class="contact-row">
          <span class="k">GitHub</span>
          <a href={github}>github.com/chennakeshavadasa</a>
        </div>
        <div class="contact-row">
          <span class="k">LinkedIn</span>
          <a href={linkedin}>linkedin.com/in/nithin-purushothama-70664727b</a>
        </div>
      </div>
    </section>

    <div class="site-footer" role="contentinfo">
      <span>Typeset in Computer Modern</span>
      <span aria-hidden="true">·</span>
      <span>&copy; 2026 Nithin Purushothama</span>
      <span aria-hidden="true">·</span>
      <a href={github}>GitHub</a>
      <span aria-hidden="true">·</span>
      <a href={linkedin}>LinkedIn</a>
    </div>
  </div>
</Layout>
