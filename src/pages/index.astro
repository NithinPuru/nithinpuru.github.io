  <script is:inline>
  (function () {
    const sections = document.querySelectorAll('#publications, #awards');
    if (!sections.length || !('IntersectionObserver' in window)) return;

    const observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) {
            var openDetails = entry.target.querySelectorAll('details[open]');
            if (!openDetails.length) return;

            var scrollY      = window.scrollY;
            var heightBefore = document.body.scrollHeight;

            openDetails.forEach(function (det) {
              det.removeAttribute('open');
              det.dispatchEvent(new Event('toggle')); // fires GIF pause handler
            });

            // After browser repaints, measure how much the page shrank
            // and shift scrollY up by exactly that amount so the viewport
            // doesn't move relative to the content below the collapsed section
            requestAnimationFrame(function () {
              var collapsed = heightBefore - document.body.scrollHeight;
              if (collapsed > 0) {
                window.scrollTo({ top: scrollY - collapsed, behavior: 'instant' });
              }
            });
          }
        });
      },
      { threshold: 0 }
    );

    sections.forEach(function (s) { observer.observe(s); });
  })();
  </script>
