                  const lbClose = document.getElementById('gif-lb-close');
                  const thumb   = document.querySelector('.award-gif-img');
                  const expandBtn = document.querySelector('.award-gif-expand-btn');

                  if (!lb || !lbImg || !thumb) return;

                  const GIF = '/img/iba_transient_animation.gif';

                  function openLb() {
                    lbImg.src = GIF;
                    lb.hidden = false;
                    document.body.style.overflow = 'hidden';
                    if (lbClose) lbClose.focus();
                  }

                  function closeLb() {
                    if (lb.hidden) return;
                    lb.hidden = true;
                    lbImg.src = '';
                    document.body.style.overflow = '';
                  }

                  // Click thumbnail or expand button → open lightbox
                  thumb.style.cursor = 'zoom-in';
                  thumb.addEventListener('click', openLb);

                  if (expandBtn) {
                    expandBtn.addEventListener('click', function (e) {
                      e.stopPropagation();
                      openLb();
                    });
                  }

                  // Close lightbox
                  if (lbClose) lbClose.addEventListener('click', closeLb);
                  lb.addEventListener('click', function (e) { if (e.target === lb) closeLb(); });
                  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeLb(); });

                  // Pause GIF when the awards details closes
                  const det = document.querySelector('#awards details');
                  if (det) {
                    det.addEventListener('toggle', function () {
                      if (det.open) {
                        if (!thumb.src || thumb.src === location.href) thumb.src = GIF;
                      } else {
                        thumb.src = '';
                        closeLb();
                      }
                    });
                  }
                }

                // Run after DOM is ready (is:inline scripts can fire before DOMContentLoaded)
                if (document.readyState === 'loading') {
                  document.addEventListener('DOMContentLoaded', init);
                } else {
                  init();
                }
              })();
