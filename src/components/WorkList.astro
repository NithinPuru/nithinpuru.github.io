---
import Icon from "./Icon.astro";
import Gallery from "./Gallery.astro";
import Symbol, { type SymbolName } from "./Symbol.astro";
import { githubStats, repoFor } from "../lib/github";

interface EntryLink {
  label: string;
  url: string;
}

interface EntryImage {
  url: string;
  label?: string;
  id: string;
}

interface EntryPlot {
  url: string;
  caption?: string;
}

interface Entry {
  title: string;
  url?: string;
  desc?: string;
  points?: string[];
  symbol?: SymbolName;
  preview?: { url: string; caption?: string };
  specs?: { k: string; v: string }[];
  meta?: string;
  tag?: string;
  tagHot?: boolean;
  links?: EntryLink[];
  abstract?: string;
  gif?: string;
  gifCaption?: string;
  images?: EntryImage[];
  imagesTitle?: string;
  plots?: EntryPlot[];
  siliconStatus?: string;
}

interface Group {
  heading?: string;
  entries: Entry[];
}

interface Props {
  groups: Group[];
  /** "grid" sets entries in two hairline-ruled columns on wide screens;
   *  "chip" (tape-outs) leads each entry with its first image as a die plate. */
  layout?: "list" | "grid" | "chip";
}

const { groups, layout = "list" } = Astro.props;
const gh = await githubStats("chennakeshavadasa");
---
<div class={"worklist" + (layout !== "list" ? ` worklist--${layout}` : "")}>
  {
    groups.map((group) => (
      <div data-reveal-group>
        {group.heading && (
          <h3 class="group-head">
            {group.heading} <span class="group-count">{group.entries.length}</span>
          </h3>
        )}
        <ul class="entries">
          {
            group.entries.map((entry) => {
              const repo = repoFor(gh, entry.url);
              // A "Source" link is added for repository URLs unless the entry
              // already lists its own source link.
              const hasSource = entry.links?.some((l) => /source/i.test(l.label));
              const isRepo = /^https:\/\/github\.com\/[^/]+\/[^/#?]+/i.test(entry.url ?? "");
              const showSource = isRepo && !hasSource;
              const chip = layout === "chip" && !!entry.images?.length;
              const [die, ...extra] = chip ? entry.images! : [];
              return (
              <li class={"entry" + (chip ? " entry--chip" : "") + (entry.symbol ? " entry--sym" : "")} data-reveal>
                {entry.symbol && (
                  <span class="entry__symtile" aria-hidden="true"><Symbol name={entry.symbol} /></span>
                )}
                {chip && (
                  <figure class="chip__die">
                    <a href={die.url} data-lightbox data-caption={die.label ?? entry.title} aria-label={`Expand image: ${die.label ?? entry.title}`}>
                      <img src={die.url} alt={die.label ?? entry.title} loading="lazy" decoding="async" />
                      <span class="chip__zoom" aria-hidden="true"><Icon name="expand" size={12} /></span>
                    </a>
                    {die.label && <figcaption>{die.label}</figcaption>}
                  </figure>
                )}
                <div class="entry__main">
                <div class="entry__top">
                  <h4 class="entry__title">
                    {entry.url ? (
                      <a href={entry.url} target="_blank" rel="noopener noreferrer">{entry.title}</a>
                    ) : (
                      entry.title
                    )}
                  </h4>
                  <span class="entry__marks">
                    {repo && repo.stars > 0 && (
                      <span class="entry__stars" title={`${repo.stars} GitHub stars`}>
                        <Icon name="star" size={12} />
                        {repo.stars}
                      </span>
                    )}
                    {entry.tag && (
                      <span class={"entry__tag" + (entry.tagHot ? " is-hot" : "")}>{entry.tag}</span>
                    )}
                  </span>
                </div>

                {entry.meta && <p class="entry__kw">{entry.meta}</p>}

                {entry.specs && (
                  <dl class="entry__specs" aria-label="Key specifications">
                    {entry.specs.map((sp) => (
                      <div><dt set:html={sp.k} /><dd set:html={sp.v} /></div>
                    ))}
                  </dl>
                )}

                {entry.desc && <p class="entry__desc" set:html={entry.desc} />}

                {entry.points && (
                  <ul class="entry__points">
                    {entry.points.map((pt) => <li set:html={pt} />)}
                  </ul>
                )}

                {entry.preview && (
                  <figure class="entry__preview">
                    <a href={entry.preview.url} data-lightbox data-caption={entry.title} aria-label={`Expand preview: ${entry.title}`}>
                      <img src={entry.preview.url} alt={`${entry.title} preview`} loading="lazy" decoding="async" />
                    </a>
                    {entry.preview.caption && <figcaption set:html={entry.preview.caption} />}
                  </figure>
                )}

                {entry.gif && (
                  <figure class="entry__gif">
                    <img src={entry.gif} alt={entry.title + " - animation"} loading="lazy" decoding="async" />
                    {entry.gifCaption && <figcaption set:html={entry.gifCaption} />}
                  </figure>
                )}

                {entry.plots && entry.plots.length > 0 && (
                  <div class="entry__plots">
                    {entry.plots.map((plot) => (
                      <figure class="entry__plot-item">
                        <img src={plot.url} alt={plot.caption ?? "Notebook plot"} loading="lazy" decoding="async" />
                        {plot.caption && <figcaption>{plot.caption}</figcaption>}
                      </figure>
                    ))}
                  </div>
                )}

                {entry.abstract && (
                  <details class="fold">
                    <summary>Abstract</summary>
                    <div class="fold__body" set:html={entry.abstract} />
                  </details>
                )}

                {chip && extra.length > 0 && (
                  <ul class="chip__thumbs" aria-label="Board and lab photos">
                    {extra.map((img) => (
                      <li>
                        <a href={img.url} data-lightbox data-caption={img.label ?? entry.title} aria-label={`Expand image: ${img.label ?? entry.title}`}>
                          <img src={img.url} alt={img.label ?? entry.title} loading="lazy" decoding="async" />
                        </a>
                        {img.label && <span>{img.label}</span>}
                      </li>
                    ))}
                  </ul>
                )}

                {!chip && entry.images && entry.images.length > 0 && (
                  <Gallery images={entry.images} title={entry.imagesTitle} alt={entry.title} />
                )}

                {entry.siliconStatus && <p class="entry__silicon-status">{entry.siliconStatus}</p>}

                {(showSource || entry.links) && (
                  <ul class="entry__links">
                    {showSource && (
                      <li>
                        <a href={entry.url} target="_blank" rel="noopener noreferrer">
                          <Icon name="github" size={13} />
                          Source
                        </a>
                      </li>
                    )}
                    {entry.links?.map((link) => (
                      <li>
                        <a href={link.url} target="_blank" rel="noopener noreferrer">
                          <Icon name={/source/i.test(link.label) ? "github" : "external"} size={13} />
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
                </div>
              </li>
              );
            })
          }
        </ul>
      </div>
    ))
  }
</div>

<style>
  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* ── GIF ──────────────────────────────────────────────── */
  .entry__gif {
    margin: 1rem 0;
    border: 1px solid var(--rule);
  }
  .entry__gif img {
    display: block;
    width: 100%;
    height: auto;
  }
  .entry__gif figcaption {
    font-size: 0.82rem;
    color: var(--ink-3);
    text-align: center;
    padding: 0.4rem 0.6rem;
    border-top: 1px solid var(--rule);
    font-family: var(--font-mono);
  }

  /* ── Notebook plots ───────────────────────────────────── */
  .entry__plots {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin: 0.8rem 0;
  }
  .entry__plot-item {
    flex: 1;
    min-width: 240px;
    margin: 0;
    border: 1px solid var(--rule);
  }
  .entry__plot-item img {
    display: block;
    width: 100%;
    height: auto;
  }
  .entry__plot-item figcaption {
    font-size: 0.82rem;
    color: var(--ink-3);
    text-align: center;
    padding: 0.3rem 0.5rem;
    border-top: 1px solid var(--rule);
    font-family: var(--font-mono);
  }

  /* ── Silicon status ───────────────────────────────────── */
  .entry__silicon-status {
    display: inline-block;
    font-size: 0.84rem;
    font-family: var(--font-mono);
    color: var(--ink-3);
    border: 1px solid var(--rule);
    padding: 0.2rem 0.7rem;
    margin-top: 0.5rem;
    letter-spacing: 0.04em;
  }
</style>
