---
import Icon from "./Icon.astro";
import Gallery from "./Gallery.astro";

interface EntryLink {
  label: string;
  url: string;
}

interface EntryImage {
  url: string;
  label?: string;
  id: string;
}

interface EntryPlot {
  url: string;
  caption?: string;
}

interface Entry {
  title: string;
  url?: string;
  desc?: string;
  meta?: string;
  tag?: string;
  tagHot?: boolean;
  links?: EntryLink[];
  abstract?: string;
  gif?: string;
  gifCaption?: string;
  images?: EntryImage[];
  imagesTitle?: string;
  plots?: EntryPlot[];
  siliconStatus?: string;
}

interface Group {
  heading?: string;
  entries: Entry[];
}

interface Props {
  groups: Group[];
}

const { groups } = Astro.props;
---
<div class="worklist">
  {
    groups.map((group) => (
      <div data-reveal-group>
        {group.heading && <h3 class="group-head">{group.heading}</h3>}
        <ul class="entries">
          {
            group.entries.map((entry) => (
              <li class="entry" data-reveal>
                <div class="entry__body">
                <div class="entry__top">
                  <h4 class="entry__title">
                    <a href={entry.url} target="_blank" rel="noopener noreferrer">
                      {entry.title}
                      {entry.url && (
                        <span class="entry__arrow" aria-hidden="true">
                          <Icon name="external" />
                        </span>
                      )}
                    </a>
                  </h4>
                  {entry.tag && (
                    <span class={"entry__tag" + (entry.tagHot ? " is-hot" : "")}>
                      {entry.tag}
                    </span>
                  )}
                </div>
                
                {entry.desc && <p class="entry__desc" set:html={entry.desc}></p>}

                {/* GIF animation */}
                {entry.gif && (
                  <figure class="entry__gif">
                    <img
                      src={entry.gif}
                      alt={entry.title + " - animation"}
                      loading="lazy"
                      decoding="async"
                    />
                    {entry.gifCaption && <figcaption set:html={entry.gifCaption} />}
                  </figure>
                )}

                {/* Notebook plots */}
                {entry.plots && entry.plots.length > 0 && (
                  <div class="entry__plots">
                    {entry.plots.map((plot) => (
                      <figure class="entry__plot-item">
                        <img
                          src={plot.url}
                          alt={plot.caption ?? "Notebook plot"}
                          loading="lazy"
                          decoding="async"
                        />
                        {plot.caption && <figcaption>{plot.caption}</figcaption>}
                      </figure>
                    ))}
                  </div>
                )}

                {entry.abstract && (
                  <details class="fold">
                    <summary>Abstract</summary>
                    <div class="fold__body" set:html={entry.abstract} />
                  </details>
                )}

                {entry.images && entry.images.length > 0 && (
                  <Gallery images={entry.images} title={entry.imagesTitle} alt={entry.title} />
                )}

                {/* Silicon status badge */}
                {entry.siliconStatus && (
                  <p class="entry__silicon-status">{entry.siliconStatus}</p>
                )}

                <div class="entry__meta">
                  {entry.meta && <span>{entry.meta}</span>}
                  {entry.links && (
                    <span class="entry__links">
                      {entry.links.map((link) => (
                        <a href={link.url} target="_blank" rel="noopener noreferrer">
                          <Icon name="external" />
                          {link.label}
                        </a>
                      ))}
                    </span>
                  )}
                </div>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    ))
  }
</div>

<style>
  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .entry__arrow {
    display: inline-block;
    margin-left: 0.4rem;
    vertical-align: 2px;
    color: var(--accent);
  }
  .entry__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .entry__links a svg { color: var(--accent); }

  /* ── GIF ──────────────────────────────────────────────── */
  .entry__gif {
    margin: 1rem 0;
    border: 1px solid var(--rule);
  }
  .entry__gif img {
    display: block;
    width: 100%;
    height: auto;
  }
  .entry__gif figcaption {
    font-size: 0.76rem;
    color: var(--ink-3);
    text-align: center;
    padding: 0.4rem 0.6rem;
    border-top: 1px solid var(--rule);
    font-family: var(--font-mono);
  }

  /* ── Notebook plots ───────────────────────────────────── */
  .entry__plots {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin: 0.8rem 0;
  }
  .entry__plot-item {
    flex: 1;
    min-width: 240px;
    margin: 0;
    border: 1px solid var(--rule);
  }
  .entry__plot-item img {
    display: block;
    width: 100%;
    height: auto;
  }
  .entry__plot-item figcaption {
    font-size: 0.76rem;
    color: var(--ink-3);
    text-align: center;
    padding: 0.3rem 0.5rem;
    border-top: 1px solid var(--rule);
    font-family: var(--font-mono);
  }

  /* ── Silicon status ───────────────────────────────────── */
  .entry__silicon-status {
    display: inline-block;
    font-size: 0.78rem;
    font-family: var(--font-mono);
    color: var(--ink-3);
    border: 1px solid var(--rule);
    padding: 0.2rem 0.7rem;
    margin-top: 0.5rem;
    letter-spacing: 0.04em;
  }
</style>
