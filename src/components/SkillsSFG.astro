---
// SkillsSFG.astro — Signal Flow Graph skills visualisation
---

<div class="sfg-outer">

  <svg viewBox="0 0 700 400" id="sfg" class="sfg-svg" aria-label="Signal flow graph of Nithin's skills">
    <defs>
      <marker id="ar0" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
        <path d="M0,1 L8,4 L0,7 L1.5,4Z" fill="#bbb"/>
      </marker>
      <marker id="ar1" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
        <path d="M0,1 L8,4 L0,7 L1.5,4Z" fill="#111"/>
      </marker>
    </defs>

    <!-- BRANCHES -->
    <path id="b12" class="sfg-br" d="M74,188 C122,188 155,108 202,100" stroke="#ccc" stroke-width="1.5" fill="none" marker-end="url(#ar0)"/>
    <path id="b13" class="sfg-br" d="M74,200 L202,200" stroke="#ccc" stroke-width="1.5" fill="none" marker-end="url(#ar0)"/>
    <path id="b14" class="sfg-br" d="M74,212 C122,214 155,298 202,308" stroke="#ccc" stroke-width="1.5" fill="none" marker-end="url(#ar0)"/>
    <path id="b25" class="sfg-br" d="M282,90 C335,78 385,92 420,104" stroke="#ccc" stroke-width="1.5" fill="none" marker-end="url(#ar0)"/>
    <path id="b35" class="sfg-br" d="M280,192 C325,162 378,138 420,120" stroke="#ccc" stroke-width="1.2" stroke-dasharray="5,3" fill="none" marker-end="url(#ar0)"/>
    <path id="b26" class="sfg-br" d="M280,112 C328,148 375,212 420,238" stroke="#ccc" stroke-width="1.5" fill="none" marker-end="url(#ar0)"/>
    <path id="b36" class="sfg-br" d="M282,210 L420,250" stroke="#ccc" stroke-width="1.5" fill="none" marker-end="url(#ar0)"/>
    <path id="b46" class="sfg-br" d="M282,312 C328,300 375,276 420,264" stroke="#ccc" stroke-width="1.5" fill="none" marker-end="url(#ar0)"/>
    <path id="b57" class="sfg-br" d="M502,112 C545,124 572,160 604,184" stroke="#ccc" stroke-width="1.5" fill="none" marker-end="url(#ar0)"/>
    <path id="b67" class="sfg-br" d="M502,252 C546,248 572,230 604,216" stroke="#ccc" stroke-width="1.5" fill="none" marker-end="url(#ar0)"/>
    <path id="bloop" class="sfg-br" d="M228,163 C226,132 256,128 250,158" stroke="#ddd" stroke-width="1.1" stroke-dasharray="3,3" fill="none" marker-end="url(#ar0)"/>

    <!-- Branch labels — EB Garamond italic, dark -->
    <text x="122" y="131" class="sfg-bl">analog circuits</text>
    <text x="118" y="196" class="sfg-bl">methodology</text>
    <text x="120" y="268" class="sfg-bl">EDA &amp; tools</text>
    <text x="352" y="68"  class="sfg-bl">process technology</text>
    <text x="338" y="234" class="sfg-bl">publications &amp; awards</text>
    <text x="345" y="320" class="sfg-bl">open PDK tapeouts</text>
    <text x="560" y="138" class="sfg-bl">silicon</text>
    <text x="560" y="246" class="sfg-bl">impact</text>
    <text x="218" y="127" class="sfg-bl" style="font-size:9px">iteration</text>

    <!-- Variable labels via foreignObject (KaTeX rendered by JS) -->
    <foreignObject x="20"  y="147" width="56" height="24"><div xmlns="http://www.w3.org/1999/xhtml" id="sfg-fo1" class="sfg-fo"></div></foreignObject>
    <foreignObject x="188" y="50"  width="56" height="24"><div xmlns="http://www.w3.org/1999/xhtml" id="sfg-fo2" class="sfg-fo"></div></foreignObject>
    <foreignObject x="188" y="150" width="56" height="24"><div xmlns="http://www.w3.org/1999/xhtml" id="sfg-fo3" class="sfg-fo"></div></foreignObject>
    <foreignObject x="188" y="260" width="56" height="24"><div xmlns="http://www.w3.org/1999/xhtml" id="sfg-fo4" class="sfg-fo"></div></foreignObject>
    <foreignObject x="416" y="58"  width="56" height="24"><div xmlns="http://www.w3.org/1999/xhtml" id="sfg-fo5" class="sfg-fo"></div></foreignObject>
    <foreignObject x="416" y="208" width="56" height="24"><div xmlns="http://www.w3.org/1999/xhtml" id="sfg-fo6" class="sfg-fo"></div></foreignObject>
    <foreignObject x="606" y="152" width="56" height="24"><div xmlns="http://www.w3.org/1999/xhtml" id="sfg-fo7" class="sfg-fo"></div></foreignObject>

    <!-- Nodes -->
    <g id="sfg-n1" class="sfg-nd" data-id="1">
      <circle cx="52" cy="200" r="22" fill="var(--bg-1,#faf9f4)" stroke="#888" stroke-width="1.8" class="sfg-nc"/>
      <text x="52" y="200" class="sfg-sigma">&#x3A3;</text>
    </g>
    <text x="52" y="234" class="sfg-nsub">source</text>

    <g id="sfg-n2" class="sfg-nd" data-id="2">
      <circle cx="242" cy="100" r="40" fill="var(--bg-1,#faf9f4)" stroke="#555" stroke-width="1.5" class="sfg-nc"/>
      <circle cx="242" cy="100" r="35" fill="none" stroke="#ccc" stroke-width="1"/>
      <text x="242" y="94"  class="sfg-nl">Analog</text>
      <text x="242" y="112" class="sfg-nl">Design</text>
    </g>

    <g id="sfg-n3" class="sfg-nd" data-id="3">
      <circle cx="242" cy="202" r="40" fill="var(--bg-1,#faf9f4)" stroke="#555" stroke-width="1.5" class="sfg-nc"/>
      <circle cx="242" cy="202" r="35" fill="none" stroke="#ccc" stroke-width="1"/>
      <text x="242" y="196" class="sfg-nl">Research</text>
      <text x="242" y="214" class="sfg-nl">Methods</text>
    </g>

    <g id="sfg-n4" class="sfg-nd" data-id="4">
      <circle cx="242" cy="310" r="40" fill="var(--bg-1,#faf9f4)" stroke="#555" stroke-width="1.5" class="sfg-nc"/>
      <circle cx="242" cy="310" r="35" fill="none" stroke="#ccc" stroke-width="1"/>
      <text x="242" y="304" class="sfg-nl">EDA &amp;</text>
      <text x="242" y="322" class="sfg-nl">Tools</text>
    </g>

    <g id="sfg-n5" class="sfg-nd" data-id="5">
      <circle cx="462" cy="114" r="42" fill="var(--bg-1,#faf9f4)" stroke="#111" stroke-width="2.2" class="sfg-nc"/>
      <circle cx="462" cy="114" r="36" fill="none" stroke="#888" stroke-width=".8"/>
      <text x="462" y="108" class="sfg-nl">Process</text>
      <text x="462" y="126" class="sfg-nl">Nodes</text>
    </g>

    <g id="sfg-n6" class="sfg-nd" data-id="6">
      <circle cx="462" cy="256" r="42" fill="var(--bg-1,#faf9f4)" stroke="#111" stroke-width="2.2" class="sfg-nc"/>
      <circle cx="462" cy="256" r="36" fill="none" stroke="#888" stroke-width=".8"/>
      <text x="462" y="249" class="sfg-nl">Research</text>
      <text x="462" y="267" class="sfg-nl">Output</text>
    </g>

    <g id="sfg-n7" class="sfg-nd" data-id="7">
      <circle cx="634" cy="200" r="28" fill="#111" stroke="#111" stroke-width="1.5" class="sfg-nc"/>
      <text x="634" y="200" class="sfg-sigma" style="fill:var(--bg-1,#faf9f4)">&#x3A3;</text>
    </g>
    <text x="634" y="240" class="sfg-nsub">output</text>

    <circle id="sfg-dot" r="5" fill="#111" opacity="0" pointer-events="none"/>
  </svg>


  <!-- Skills panel -->
  <div class="sfg-panel" id="sfg-panel">
    <p class="sfg-empty" id="sfg-empty">hover a node to explore</p>
    <div id="sfg-content" style="display:none">
      <div class="sfg-ph">
        <span id="sfg-abbr" class="sfg-abbr"></span>
        <span class="sfg-dot">&thinsp;&middot;&thinsp;</span>
        <span id="sfg-cat" class="sfg-cat"></span>
      </div>
      <div id="sfg-groups" class="sfg-groups"></div>
      <p id="sfg-desc" class="sfg-desc"></p>
    </div>
  </div>

  <div class="sfg-legend">
    <span><code>○</code> domain node</span>
    <span><code>⊙</code> key credential</span>
    <span><code>●</code> output</span>
    <span><code>- -</code> feedback</span>
  </div>

</div>

<style is:global>
.sfg-outer { margin-top: 1rem; }
.sfg-svg   { width: 100%; display: block; }

.sfg-nl    { font-family: var(--font-serif); font-size: 15px; font-weight: 700; fill: var(--ink-1); text-anchor: middle; dominant-baseline: middle; }
.sfg-bl    { font-family: var(--font-serif); font-size: 13px; font-style: italic; fill: var(--ink-1); text-anchor: middle; }
.sfg-sigma { font-family: var(--font-serif); font-size: 24px; fill: var(--ink-1); text-anchor: middle; dominant-baseline: middle; }
.sfg-nsub  { font-family: var(--font-mono); font-size: 10px; fill: var(--ink-3); text-anchor: middle; }

.sfg-fo {
  font-size: 13px;
  color: var(--ink-1);
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
}

.sfg-nd { cursor: pointer; }

/* ── SFG Panel ─────────────────────────────── */
.sfg-panel {
  border-top: 1px solid var(--rule);
  margin-top: 0.6rem;
  padding: 1rem 0 0.5rem;
  min-height: 110px;
}
.sfg-empty {
  font-family: var(--font-serif);
  font-size: 1rem;
  font-style: italic;
  color: var(--ink-3);
}
.sfg-ph {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 0.9rem;
  padding-bottom: 0.6rem;
  border-bottom: 1px solid var(--rule);
}
.sfg-abbr {
  font-family: var(--font-mono);
  font-size: 0.62rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--ink-3);
  border: 1px solid var(--rule);
  padding: 0.12rem 0.45rem;
}
.sfg-dot { color: var(--ink-3); font-size: 0.9rem; }
.sfg-cat {
  font-family: var(--font-serif);
  font-size: 1.35rem;
  font-weight: 700;
  color: var(--ink-1);
  line-height: 1;
}
.sfg-groups {
  display: flex;
  flex-direction: column;
  gap: 0.9rem;
  margin-bottom: 0.75rem;
}
.sfg-group-title {
  font-family: var(--font-mono) !important;
  font-size: 0.58rem !important;
  letter-spacing: 0.2em !important;
  text-transform: uppercase !important;
  color: var(--ink-3) !important;
  margin-bottom: 0.35rem !important;
  font-style: normal !important;
}
.sfg-group-items {
  display: grid !important;
  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)) !important;
  gap: 0.15rem 1rem !important;
}
.sfg-item {
  font-family: var(--font-serif) !important;
  font-size: 0.88rem !important;
  color: var(--ink-2) !important;
  line-height: 1.5 !important;
  padding-left: 0.85rem !important;
  position: relative !important;
}
.sfg-item::before {
  content: '◦' !important;
  position: absolute !important;
  left: 0 !important;
  color: var(--ink-3) !important;
  font-size: 0.75rem !important;
}
.sfg-item.hi {
  color: var(--ink-1) !important;
  font-weight: 600 !important;
}
.sfg-item.hi::before {
  content: '◆' !important;
  color: var(--ink-2) !important;
  font-size: 0.5rem !important;
  top: 0.25rem !important;
}
.sfg-desc {
  font-family: var(--font-serif) !important;
  font-size: 0.88rem !important;
  font-style: italic !important;
  color: var(--ink-3) !important;
  line-height: 1.65 !important;
  border-top: 1px solid var(--rule) !important;
  padding-top: 0.55rem !important;
}
.sfg-legend {
  display: flex;
  gap: 1.4rem;
  margin-top: 0.5rem;
  flex-wrap: wrap;
  font-family: var(--font-serif);
  font-size: 0.88rem;
  font-style: italic;
  color: var(--ink-3);
}
.sfg-legend code {
  font-family: var(--font-mono);
  font-style: normal;
  font-size: 0.7rem;
  color: var(--ink-2);
}
</style>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.9/katex.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.9/katex.min.js" is:inline></script>

<script is:inline>
(function () {
  function kt(expr, el) {
    if (typeof katex === 'undefined' || !el) return;
    try { katex.render(expr, el, { throwOnError: false }); } catch (e) {}
  }

  function init() {
    var foLabels = {
      1: '\\Sigma',
      2: 'x_{\\text{AD}}',
      3: 'x_{\\text{RM}}',
      4: 'x_{\\text{EDA}}',
      5: 'x_{\\text{PN}}',
      6: 'x_{\\text{RO}}',
      7: '\\Sigma',
    };
    Object.keys(foLabels).forEach(function(i) {
      kt(foLabels[i], document.getElementById('sfg-fo' + i));
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  var ND = {
    1: {
      abbr: 'SRC', label: 'Background',
      desc: 'BSc ECE, VTU (CGPA 8.6) \u00b7 ISRO SAC Hassan \u00b7 LP-CAS Lab IIT Gandhinagar \u00b7 PhyTau Semiconductors \u00b7 Omni Design Technologies.',
      groups: []
    },
    2: {
      abbr: 'AD', label: 'Analog Design',
      desc: 'Hands-on IC design at IIT Gandhinagar LP-CAS Lab, PhyTau Semiconductors, and Omni Design Technologies across open-source PDKs and industrial processes.',
      groups: [
        {
          title: 'Core Circuits',
          items: ['Ring Amplifiers', 'Dynamic Amplifiers', 'OTAs / OPAMPs', 'Bandgap References', 'LDO Design', 'PVT Monitors', 'Current Mirrors', 'Startup Circuits', 'Self-biased Cascode OTA'],
          accent: ['Ring Amplifiers', 'Dynamic Amplifiers', 'OTAs / OPAMPs', 'Bandgap References']
        },
        {
          title: 'Design & Verification Flow',
          items: ['Tapeout Flow (DRC \u00b7 LVS \u00b7 PEX)', 'Switched Capacitor Circuits', 'DSP Circuits'],
          accent: ['Tapeout Flow (DRC \u00b7 LVS \u00b7 PEX)']
        }
      ]
    },
    3: {
      abbr: 'RM', label: 'Research Methods',
      desc: 'Developed the R\u2092\u2099/g\u2098 methodology at LP-CAS Lab, IIT Gandhinagar \u2014 co-designs both non-linear RC settling and linear g\u2098 settling phases via pre-characterised LUTs, exposing process-corner worst-case behaviour at design entry without iterative transient simulation.',
      groups: [
        {
          title: 'Novel Methodology (ESSERC 2026)',
          items: ['R\u2092\u2099/g\u2098 Design Methodology', 'Two-phase Settling Model (NL + LS)', 'LUT-based Pre-simulation Design', 'Deadzone Bias Characterisation', 'Peak Slew Current Prediction'],
          accent: ['R\u2092\u2099/g\u2098 Design Methodology', 'Two-phase Settling Model (NL + LS)']
        },
        {
          title: 'Established Methods & Analysis',
          items: ['g\u2098/I_D Methodology', 'Process Corner Analysis', 'Monte Carlo Simulation', 'Open-Source IC Design', 'Parametric SPICE Simulation'],
          accent: ['g\u2098/I_D Methodology']
        }
      ]
    },
    4: {
      abbr: 'EDA', label: 'EDA & Tools',
      desc: 'Experienced in both open-source and commercial EDA toolchains. Automates design, simulation, and verification flows using Python scripting across multiple PDKs.',
      groups: [
        {
          title: 'Commercial Tools',
          items: ['Cadence Virtuoso / Spectre', 'Keysight ADS', 'LTspice'],
          accent: ['Cadence Virtuoso / Spectre']
        },
        {
          title: 'Open-Source Tools',
          items: ['Ngspice', 'Xschem', 'Magic VLSI', 'KLayout', 'Netgen'],
          accent: ['Ngspice', 'Xschem', 'Magic VLSI']
        },
        {
          title: 'Programming & Automation',
          items: ['Python (EDA Automation)', 'MATLAB', 'LaTeX', 'Git / GitHub'],
          accent: ['Python (EDA Automation)']
        }
      ]
    },
    5: {
      abbr: 'PN', label: 'Process Nodes',
      desc: 'Silicon fabricated or taped-out across 5 distinct process technologies \u2014 3 open-source PDK shuttles and 2 industrial commercial nodes, each with full design, layout, and pre-tapeout sign-off.',
      groups: [
        {
          title: 'Industrial (Commercial)',
          items: ['TSMC 28\u00a0nm CMOS \u2014 Omni Design Technologies', 'UMC 55\u00a0nm CMOS \u2014 PhyTau Semiconductors'],
          accent: ['TSMC 28\u00a0nm CMOS \u2014 Omni Design Technologies', 'UMC 55\u00a0nm CMOS \u2014 PhyTau Semiconductors']
        },
        {
          title: 'Open-Source PDK (Fabricated via Shuttle)',
          items: ['IHP SG13G2 \u2014 130\u00a0nm BiCMOS', 'SKY130 \u2014 SkyWater 130\u00a0nm', 'GF180MCU-D \u2014 GlobalFoundries 180\u00a0nm'],
          accent: ['IHP SG13G2 \u2014 130\u00a0nm BiCMOS', 'SKY130 \u2014 SkyWater 130\u00a0nm', 'GF180MCU-D \u2014 GlobalFoundries 180\u00a0nm']
        }
      ]
    },
    6: {
      abbr: 'RO', label: 'Research Output',
      desc: 'Two peer-reviewed IEEE papers, a $5,000 SSCS award, and fabricated silicon across 5 process nodes. R\u2092\u2099/g\u2098 paper accepted at ESSERC 2026 (Palma de Mallorca, September 2026) and validated on IHP SG13G2 BiCMOS using open-source EDA tools.',
      groups: [
        {
          title: 'Publications',
          items: [
            'ESSERC 2026 \u2014 R\u2092\u2099/g\u2098 Based Design Methodology for Dynamic Amplifiers (accepted, poster)',
            'IEEE ICEE 2025 \u2014 Analog CMOS Multiplier Circuits: Design and Comparative Analysis (published)'
          ],
          accent: ['ESSERC 2026 \u2014 R\u2092\u2099/g\u2098 Based Design Methodology for Dynamic Amplifiers (accepted, poster)']
        },
        {
          title: 'Award',
          items: ['IEEE SSCS Code-a-Chip Travel Grant \u2014 $5,000 (Young Professional category)'],
          accent: ['IEEE SSCS Code-a-Chip Travel Grant \u2014 $5,000 (Young Professional category)']
        },
        {
          title: 'Fabricated Silicon',
          items: [
            'SKY130 \u2014 Piecewise-Compensated BGR (sub-5\u202fppm/\u00b0C TC)',
            'GF180MCU \u2014 Folded-Cascode OTA',
            'IHP SG13G2 \u2014 Inverter-based Dynamic Amplifier',
            'UMC 55\u00a0nm \u2014 PWM Comparator for DC\u2013DC converter (PhyTau)',
            'TSMC 28\u00a0nm \u2014 PVT Monitor & Reference IPs (Omni Design)'
          ],
          accent: ['SKY130 \u2014 Piecewise-Compensated BGR (sub-5\u202fppm/\u00b0C TC)', 'TSMC 28\u00a0nm \u2014 PVT Monitor & Reference IPs (Omni Design)']
        },
        {
          title: 'Other',
          items: [
            'ISRO \u2014 C-Band antenna calibration, GSAT-31 in-orbit testing',
            'Teaching Assistant \u2014 PMIC Design (EE660), IIT Gandhinagar'
          ],
          accent: []
        }
      ]
    },
    7: {
      abbr: 'OUT', label: 'Summary',
      desc: 'Analog / Mixed-Signal IC designer with end-to-end experience from circuit design through tapeout sign-off across 5 process nodes. IEEE SSCS awardee. Published at ESSERC 2026 and ICEE 2025. Seeking PhD for Fall 2027 in energy-efficient AMS design.',
      groups: [
        {
          title: 'Research & Publications',
          items: ['2 Peer-reviewed IEEE Publications', 'IEEE SSCS Code-a-Chip Travel Grant \u2014 $5,000', 'ESSERC 2026 \u00b7 IEEE ICEE 2025'],
          accent: ['IEEE SSCS Code-a-Chip Travel Grant \u2014 $5,000']
        },
        {
          title: 'Silicon & Process',
          items: ['5 Fabricated Tapeouts', '5 Process Nodes (3 open-source + 2 industrial)', 'Full DRC \u00b7 LVS \u00b7 PEX sign-off'],
          accent: ['5 Fabricated Tapeouts', '5 Process Nodes (3 open-source + 2 industrial)']
        },
        {
          title: 'Experience & Goal',
          items: ['3+ years industry & research experience', 'Open-source IC design advocate', 'Seeking PhD \u00b7 Fall 2027'],
          accent: ['Seeking PhD \u00b7 Fall 2027']
        }
      ]
    },
  };

  var BR = {
    1: ['b12','b13','b14'],
    2: ['b12','b25','b26'],
    3: ['b13','b35','b36','bloop'],
    4: ['b14','b46'],
    5: ['b25','b35','b57'],
    6: ['b26','b36','b46','b67'],
    7: ['b57','b67'],
  };

  var active = null, afs = [];
  var dot = document.getElementById('sfg-dot');

  function clrAF() { afs.forEach(cancelAnimationFrame); afs = []; }

  function activate(id) {
    if (active === id) return;
    deactivate(true);
    active = id;
    (BR[id] || []).forEach(function (bid) {
      var el = document.getElementById(bid);
      if (el) { el.setAttribute('stroke','#111'); el.setAttribute('stroke-width','2.5'); el.setAttribute('marker-end','url(#ar1)'); }
    });
    var nd = document.getElementById('sfg-n' + id);
    if (nd && id !== 7) {
      var c = nd.querySelector('circle');
      c.setAttribute('stroke','#111');
      c.setAttribute('stroke-width', id === 5 || id === 6 ? '3.5' : '3');
    }
    var pe = document.getElementById((BR[id] || [])[0]);
    if (pe && pe.getTotalLength) {
      var len = pe.getTotalLength(), dur = 460, st = performance.now();
      function step(now) {
        var t = Math.min((now - st) / dur, 1), e = 1 - Math.exp(-4.5 * t), pt = pe.getPointAtLength(e * len);
        dot.setAttribute('cx', pt.x); dot.setAttribute('cy', pt.y);
        dot.setAttribute('opacity', t < 0.92 ? '0.9' : '0');
        if (t < 1) { var f = requestAnimationFrame(step); afs.push(f); }
      }
      dot.setAttribute('opacity','0.9'); requestAnimationFrame(step);
    }
    var d = ND[id]; if (!d) return;
    document.getElementById('sfg-empty').style.display = 'none';
    document.getElementById('sfg-content').style.display = 'block';
    document.getElementById('sfg-abbr').textContent = d.abbr || '';
    document.getElementById('sfg-cat').textContent = d.label;
    var ge = document.getElementById('sfg-groups');
    ge.innerHTML = '';
    if (!d.groups || !d.groups.length) {
      ge.innerHTML = '<span style="font-family:var(--font-serif);font-style:italic;color:var(--ink-3)">signal source / sink node</span>';
    } else {
      d.groups.forEach(function (g) {
        var div = document.createElement('div');
        div.className = 'sfg-group';
        var title = document.createElement('div');
        title.className = 'sfg-group-title';
        title.textContent = g.title;
        div.appendChild(title);
        var itemsWrap = document.createElement('div');
        itemsWrap.className = 'sfg-group-items';
        g.items.forEach(function (item) {
          var row = document.createElement('div');
          var isHi = g.accent && g.accent.includes(item);
          row.className = 'sfg-item' + (isHi ? ' hi' : '');
          row.textContent = item;
          itemsWrap.appendChild(row);
        });
        div.appendChild(itemsWrap);
        ge.appendChild(div);
      });
    }
    document.getElementById('sfg-desc').textContent = d.desc || '';
  }

  function deactivate(skip) {
    clrAF();
    document.querySelectorAll('.sfg-br').forEach(function (el) {
      var dash = el.getAttribute('stroke-dasharray');
      el.setAttribute('stroke', dash ? '#ddd' : '#ccc');
      el.setAttribute('stroke-width','1.5');
      el.setAttribute('marker-end','url(#ar0)');
    });
    document.querySelectorAll('.sfg-nd').forEach(function (nd) {
      var id = parseInt(nd.dataset.id), c = nd.querySelector('circle'); if (!c) return;
      if (id === 7) { c.setAttribute('stroke','#111'); c.setAttribute('stroke-width','1.5'); }
      else if (id === 5 || id === 6) { c.setAttribute('stroke','#111'); c.setAttribute('stroke-width','2.2'); }
      else { c.setAttribute('stroke','#555'); c.setAttribute('stroke-width','1.5'); }
    });
    dot.setAttribute('opacity','0');
    if (!skip) {
      active = null;
      document.getElementById('sfg-empty').style.display = 'block';
      document.getElementById('sfg-content').style.display = 'none';
    }
  }

  document.querySelectorAll('.sfg-nd').forEach(function (nd) {
    nd.addEventListener('mouseenter', function () { activate(parseInt(nd.dataset.id)); });
    nd.addEventListener('mouseleave', function () { deactivate(false); });
  });
})();
</script>
