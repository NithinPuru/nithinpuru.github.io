---
// Collapsible image strip (layouts, PCBs, talk photos). Open by default and
// exempt from the auto-collapse observer; thumbnails open the shared lightbox.
interface Image {
  url: string;
  label?: string;
  id?: string;
}
interface Props {
  images: Image[];
  title?: string;
  alt?: string;
}
const { images, title = "Layout & PCB Images", alt = "" } = Astro.props;
---
<details class="fold gallery" data-keep-open open>
  <summary>{title}</summary>
  <div class="gallery__grid">
    {images.map((img) => (
      <figure class="gallery__item">
        <a
          class="gallery__thumb"
          href={img.url}
          data-lightbox
          data-caption={img.label ?? alt}
          aria-label={`Expand image: ${img.label ?? alt}`}
        >
          <img src={img.url} alt={img.label ?? alt} loading="lazy" decoding="async" />
        </a>
        {img.label && <figcaption>{img.label}</figcaption>}
      </figure>
    ))}
  </div>
</details>
