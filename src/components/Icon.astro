---
interface Props {
  name:
    | "external" | "down" | "close" | "expand" | "check" | "cross"
    | "github" | "linkedin" | "mail" | "file" | "star"
    | "book" | "nondual" | "compass" | "pin"
    | "column" | "lotus" | "globe";
  size?: number;
}
const { name, size } = Astro.props;
// 1.5px line icons on a 24px grid; multi-part icons are arrays of paths.
const paths: Record<string, string[]> = {
  external: ["M7 17 17 7M9 7h8v8"],
  down: ["M12 4v16M6 14l6 6 6-6"],
  close: ["M6 6l12 12M18 6 6 18"],
  expand: ["M14 4h6v6M10 20H4v-6M20 4l-7 7M4 20l7-7"],
  check: ["M5 12.5 10 17.5 19 7"],
  cross: ["M7 7l10 10M17 7 7 17"],
  github: [
    "M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21",
  ],
  linkedin: ["M3.5 3.5h17v17h-17z", "M8 10.5V17", "M8 7.3v.01", "M12 17v-6.5", "M12 13.5a2.75 2.75 0 0 1 5.5 0V17"],
  mail: ["M3 5h18v14H3z", "M3 6l9 7 9-7"],
  file: ["M6 3h8l4 4v14H6z", "M14 3v4h4", "M9 12h6M9 16h6"],
  // open book
  book: ["M12 6.5C10 5 7 4.5 3.5 5v13c3.5-.5 6.5 0 8.5 1.5 2-1.5 5-2 8.5-1.5V5C17 4.5 14 5 12 6.5z", "M12 6.5v13"],
  // two circles merging into one - non-duality
  nondual: ["M3.5 12a5.5 5.5 0 1 0 11 0a5.5 5.5 0 1 0-11 0", "M9.5 12a5.5 5.5 0 1 0 11 0a5.5 5.5 0 1 0-11 0"],
  // compass
  compass: ["M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z", "M15.5 8.5l-2 5-5 2 2-5z"],
  // Roman (Ionic) column: volute capital, fluted shaft, stepped base
  column: [
    "M3.5 4h17",
    "M5 4c0 2 1.2 3.2 3 3.2h8c1.8 0 3-1.2 3-3.2",
    "M6.5 8.5h11",
    "M8 8.5V18M10.7 8.5V18M13.3 8.5V18M16 8.5V18",
    "M6 18h12", "M4.5 20.5h15",
  ],
  // lotus - classic Vedantic image of the awakened mind
  lotus: [
    "M12 4.5c-2.2 3.2-2.2 8.3 0 12 2.2-3.7 2.2-8.8 0-12z",
    "M12 16.5c-1.4-4.2-4.6-6.6-8.5-6.8.3 4.3 3.8 6.8 8.5 6.8z",
    "M12 16.5c1.4-4.2 4.6-6.6 8.5-6.8-.3 4.3-3.8 6.8-8.5 6.8z",
    "M4 19.5h16",
  ],
  // globe with meridians and equator
  globe: [
    "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z",
    "M12 3c-3.2 2.6-3.2 15.4 0 18M12 3c3.2 2.6 3.2 15.4 0 18",
    "M3.5 9h17M3.5 15h17",
  ],
  pin: ["M12 21s-6.5-6.2-6.5-11a6.5 6.5 0 0 1 13 0c0 4.8-6.5 11-6.5 11z", "M12 7.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z"],
  star: ["M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z"],
};
const px = size ?? (name === "external" ? 13 : 14);
---
<svg viewBox="0 0 24 24" width={px} height={px} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {paths[name].map((d) => <path d={d} />)}
</svg>
