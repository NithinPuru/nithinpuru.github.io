---
// Experience as a time axis: an ink rail labelled t that points up to "now",
// the start year of each role as an axis tick, a ring-and-dot node on the
// rail, and a line-drawn DIP package carrying the organisation's initials in
// place of a logo. Summaries show dates, computed tenure, role, organisation,
// keywords and a datasheet strip of headline figures; detail expands below.
import data from "../data/experience.json";

interface Spec {
  k: string;
  v: string;
}
interface Role {
  start: string; // YYYY-MM
  end: string | null; // YYYY-MM, null = present
  role: string;
  org: string;
  place: string;
  kind: string;
  badge: string;
  keywords?: string;
  advisor?: { name: string; url: string };
  specs?: Spec[];
  detail?: string;
}

const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const now = new Date();

function parse(ym: string) {
  const [y, m] = ym.split("-").map(Number);
  return { y, m };
}
function fmt(ym: string | null) {
  if (!ym) return "Present";
  const { y, m } = parse(ym);
  return `${MONTHS[m - 1]} ${y}`;
}
// Inclusive month count, e.g. Oct 2025 – Feb 2026 = 5 mos.
function tenure(start: string, end: string | null) {
  const a = parse(start);
  const b = end ? parse(end) : { y: now.getFullYear(), m: now.getMonth() + 1 };
  const months = (b.y - a.y) * 12 + (b.m - a.m) + 1;
  const yrs = Math.floor(months / 12);
  const mos = months % 12;
  const parts = [];
  if (yrs) parts.push(`${yrs} yr`);
  if (mos) parts.push(`${mos} mo${mos > 1 ? "s" : ""}`);
  return parts.join(" ");
}

const roles = data.entries as Role[];
---
<div class="xp" data-reveal>
  <span class="xp__axis-label" aria-hidden="true"><i>t</i></span>
  <ol class="xp__list">
    {roles.map((r) => {
      const current = r.end === null;
      const small = r.badge.length > 4;
      return (
        <li class={"xp__item" + (current ? " is-current" : "")}>
          <span class="xp__tick" aria-hidden="true">{parse(r.start).y}</span>
          <svg class="xp__node" viewBox="0 0 14 14" width="14" height="14" aria-hidden="true">
            <circle cx="7" cy="7" r="5.25" />
            <circle class="xp__node-dot" cx="7" cy="7" r="2.4" />
          </svg>
          <details class="xp__entry">
            <summary class="xp__summary">
              <svg class="xp__pkg" viewBox="0 0 44 52" width="44" height="52" aria-hidden="true">
                <path class="xp__pkg-pins" d="M3 13h6M3 21h6M3 29h6M3 37h6M35 13h6M35 21h6M35 29h6M35 37h6" />
                <path class="xp__pkg-body" d="M9 4h9.5a3.5 3.5 0 0 0 7 0H35v44H9z" />
                <text x="22" y="27" text-anchor="middle" dominant-baseline="middle" font-size={small ? "7" : "9"}>{r.badge}</text>
              </svg>
              <span class="xp__meta">
                <span class="xp__dates">{fmt(r.start)} &ndash; {fmt(r.end)}</span>
                <span class="xp__tenure">{tenure(r.start, r.end)}</span>
                <span class="xp__kind">{r.kind}</span>
              </span>
              <span class="xp__role">{r.role}</span>
              <span class="xp__org">{r.org} &middot; {r.place}</span>
              {r.keywords && <span class="xp__kw" set:html={r.keywords} />}
              {r.specs && (
                <span class="entry__specs xp__specs">
                  {r.specs.map((sp) => (
                    <span class="xp__spec"><span class="xp__spec-k">{sp.k}</span><span class="xp__spec-v" set:html={sp.v} /></span>
                  ))}
                </span>
              )}
              {r.advisor && (
                <span class="xp__advisor">
                  Advisor &middot; <a href={r.advisor.url} target="_blank" rel="noopener noreferrer">{r.advisor.name}</a>
                </span>
              )}
              <span class="xp__more" aria-hidden="true">
                <span class="xp__more-open">Details</span><span class="xp__more-close">Hide</span>
              </span>
            </summary>
            {r.detail && <div class="xp__detail" set:html={r.detail} />}
          </details>
        </li>
      );
    })}
  </ol>
</div>
