---
// The portfolio moved to nithinpuru.com. GitHub Pages can't send real
// redirects, so old portfolio addresses forward in the browser (keeping
// ?query and #section) with a meta refresh as the no-JS fallback. Only the
// portfolio's own paths use this - the tools stay on this site.
const { to } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline define:vars={{ to }}>location.replace(to + location.search + location.hash);</script>
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={to} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="CbHJ7n0y8wb_nJlVVVP4BAdzb0_GmnH6HhC5Umx4Z4Y" />
    <title>Moved to nithinpuru.com</title>
  </head>
  <body>
    <p>This page has moved to <a href={to}>{to}</a>.</p>
  </body>
</html>
