---
// Schematic symbols in the site's 1.5px line style, on a 48×40 grid. Used as
// the visual anchor for Experience roles and circuit projects in place of
// logos. Stroke follows currentColor; text uses the typewriter face.
export type SymbolName =
  | "adc"
  | "dac"
  | "comparator"
  | "opamp"
  | "opamp-fd"
  | "ring"
  | "antenna"
  | "vref"
  | "ldo"
  | "sweep"
  | "ground"
  | "candles"
  | "forecast"
  | "var";

interface Props {
  name: SymbolName;
  class?: string;
}
const { name, class: cls } = Astro.props;

// Each symbol: stroked paths, plus optional labels [x, y, text].
const S: Record<SymbolName, { d: string[]; f?: string[]; dash?: string[]; t?: [number, number, string][] }> = {
  // Converter blocks: pentagon body with the conventional diagonal.
  adc: {
    d: ["M1 20h7", "M8 8h22l10 12-10 12H8z", "M8 32 30 8", "M40 20h7", "M42 23l3-6"],
    t: [[14, 15, "A"], [25, 27, "D"]],
  },
  dac: {
    d: ["M1 20h7", "M3 23l3-6", "M18 8h22v24H18L8 20z", "M18 32 40 8", "M40 20h7"],
    t: [[23, 15, "D"], [34, 27, "A"]],
  },
  // Comparator with a hysteresis glyph inside the triangle.
  comparator: {
    d: ["M9 6v28l28-14z", "M1 13h8", "M1 27h8", "M37 20h10", "M12 13h3.5M13.75 11.25v3.5", "M12 27h3.5", "M19 23h5v-6h4M21 23h4v-6h5"],
  },
  opamp: {
    d: ["M9 6v28l28-14z", "M1 13h8", "M1 27h8", "M37 20h10", "M12 13h3.5M13.75 11.25v3.5", "M12 27h3.5"],
  },
  // Fully differential: two outputs off the triangle edges.
  "opamp-fd": {
    d: ["M8 5v30l30-15z", "M1 13h7", "M1 27h7", "M28.5 15H47", "M28.5 25H47", "M11 13h3.5M12.75 11.25v3.5", "M11 27h3.5", "M34 11h3M35.5 9.5v3", "M34 29h3"],
  },
  // Ring amplifier: three inverter stages closed by a feedback wire.
  ring: {
    d: [
      "M4 13v14l9-7z", "M15 20a2 2 0 1 0 0 .01",
      "M19 13v14l9-7z", "M30 20a2 2 0 1 0 0 .01",
      "M34 13v14l9-7z", "M45 20a2 2 0 1 0 0 .01",
      "M1 20h3", "M17 20h2", "M32 20h2",
      "M47 20v14H1V20",
    ],
  },
  antenna: {
    d: ["M24 36V14", "M14 5l10 11L34 5z", "M18 36h12", "M20.5 38.5h7"],
  },
  // Reference source: circle with polarity marks and leads.
  vref: {
    d: ["M24 2v8", "M24 30v8", "M24 10a10 10 0 1 0 0 20a10 10 0 1 0 0-20", "M22 15h4M24 13v4", "M22 25h4"],
    t: [[39, 21, "REF"]],
  },
  // LDO: error amplifier driving the gate of a pass device.
  ldo: {
    d: [
      "M3 16v18l14-9z", "M5.5 21h2.5M6.75 19.75v2.5", "M5.5 29h2.5",
      "M17 25h8V12", "M22 12h6", "M28 8v8", "M28 9h8V2", "M28 15h8v23",
      "M36 30h11",
    ],
  },
  // Corner sweep: three settling traces (SS / TT / FF).
  sweep: {
    d: ["M3 36h42", "M3 36V4", "M3 30c6 0 8-20 16-20h26", "M3 30c8 0 10-14 18-14h24", "M3 30c10 0 12-8 20-8h22"],
  },
  ground: {
    d: ["M24 4v14", "M12 18h24", "M16 23h16", "M20 28h8"],
  },
  // Finance marks for the Quantitative Finance section.
  // Candlesticks: wicks with open (up) and filled (down) bodies.
  candles: {
    d: ["M2 37h44", "M8 10v26", "M5.5 16h5v12h-5z", "M18 6v22", "M15.5 10h5v10h-5z", "M28 14v20", "M25.5 18h5v11h-5z", "M38 4v18", "M35.5 7h5v10h-5z"],
    f: ["M15.5 10h5v10h-5z", "M35.5 7h5v10h-5z"],
  },
  // Time series with a dashed forecast beyond the "now" line.
  forecast: {
    d: ["M2 37h44", "M2 37V3", "M3 30l6-4 5 3 6-9 5 4 5-8", "M30 4v33"],
    dash: ["M30 16l5-3 5 1 6-6", "M30 16l6 2 5-2 5 1"],
  },
  // Return distribution with the left (VaR) tail marked.
  var: {
    d: ["M2 36h44", "M3 36c7 0 9-1 13-9s5-21 8-21 5 13 8 21 6 9 13 9", "M12 36V31"],
    f: ["M3 36c5 0 7-1 9-3.5V36z"],
  },
};
const sym = S[name];
---
<svg class={"sym" + (cls ? ` ${cls}` : "")} viewBox="0 0 48 40" width="48" height="40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {sym.d.map((d) => <path d={d} />)}
  {sym.f?.map((d) => <path d={d} fill="currentColor" />)}
  {sym.dash?.map((d) => <path d={d} stroke-dasharray="2.5 2.5" />)}
  {sym.t?.map(([x, y, s]) => (
    <text x={x} y={y} text-anchor="middle" dominant-baseline="middle" font-size="7" stroke="none" fill="currentColor">{s}</text>
  ))}
</svg>
