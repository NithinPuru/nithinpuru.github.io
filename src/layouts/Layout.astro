---
import "../styles/tools.css";

// Shell for the tools index (/tools/) and the 404 page. The tools themselves
// are standalone pages in public/ and don't use it.
const { title, description, noindex = false } = Astro.props;

// Resolves a public/ asset path against the configured base.
const asset = (p) =>
  `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${p.replace(/^\//, "")}`;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (function () {
        // Theme before first paint: saved choice, else the system setting.
        var t = null;
        try { t = localStorage.getItem("theme"); } catch (e) {}
        if (t !== "light" && t !== "dark") {
          t = window.matchMedia && matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.setAttribute("data-theme", t);
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1620" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    { noindex && <meta name="robots" content="noindex" /> }
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={asset("favicon.ico")} sizes="48x48" />
    <link rel="icon" type="image/png" sizes="192x192" href={asset("android-chrome-192x192.png")} />
    <link rel="icon" type="image/svg+xml" href={asset("favicon.svg")} />
    <link rel="apple-touch-icon" sizes="180x180" href={asset("apple-touch-icon.png")} />
    <link rel="preload" href={asset("fonts/KaTeX_Main-Regular.woff2")} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={asset("fonts/KaTeX_Main-Bold.woff2")} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={asset("fonts/KaTeX_Typewriter-Regular.woff2")} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <main id="main" class="page">
      <slot />
    </main>
    <script>
      import "../scripts/theme.js";
    </script>
    <script is:inline>
    (function () {
      var ENDPOINT = "https://nithin-analytics.nithin-analytics-worker.workers.dev/collect";
      var h = location.hostname;
      if (h === "localhost" || h === "127.0.0.1" || location.protocol === "file:") return;
      try {
        var qs = location.search;
        if (/[?&]notrack\b/.test(qs)) localStorage.setItem("np_notrack", "1");
        if (/[?&]track\b/.test(qs)) localStorage.removeItem("np_notrack");
        if (localStorage.getItem("np_notrack") === "1") return;
      } catch (e) {}
      var data = JSON.stringify({ p: location.pathname, r: document.referrer, q: location.search });
      // text/plain beacon = no CORS preflight
      if (navigator.sendBeacon) navigator.sendBeacon(ENDPOINT, data);
      else fetch(ENDPOINT, { method: "POST", body: data, keepalive: true, mode: "no-cors" });
    })();
    </script>
  </body>
</html>
