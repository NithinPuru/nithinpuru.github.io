---
import Nav from "../components/Nav.astro";
import "../styles/global.css";

const canonical = Astro.site?.href ?? Astro.url.href;

// Resolves a public/ asset path against the configured base so it stays
// correct both locally (base "/") and when deployed under a base path such as
// a GitHub Pages project site ("/repo/").
const asset = (p) =>
  `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${p.replace(/^\//, "")}`;

const description =
  "Nithin P — Analog/Mixed-Signal IC designer at the Low-Power Circuits & Systems Group, IIT Gandhinagar. Ultra-low-power data converters, biomedical circuits, wearable sensors, and a quantitative-finance side practice.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Nithin P",
  alternateName: "chennakeshavadasa",
  jobTitle: "Analog/Mixed-Signal IC Designer",
  affiliation: {
    "@type": "Organization",
    name: "Low-Power Circuits & Systems Group, IIT Gandhinagar",
  },
  email: "mailto:nithinpurushothama@gmail.com",
  sameAs: [
    "https://github.com/chennakeshavadasa",
    "https://www.linkedin.com/in/nithin-purushothama-70664727b/",
  ],
  description:
    "Analog/Mixed-Signal IC designer. Research interests: ultra-low-power data converters, biomedical circuits and wearable sensors. Secondary practice in macroeconomics and data-driven quantitative finance.",
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nithin P — Analog/Mixed-Signal IC Designer</title>
    <meta name="description" content={description} />
    <meta name="author" content="Nithin P" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content="Nithin P — Analog/Mixed-Signal IC Designer" />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content="Nithin P — Analog/Mixed-Signal IC Designer" />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={asset("favicon.svg")} />
    <link rel="preload" href={asset("fonts/KaTeX_Main-Regular.woff2")} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={asset("fonts/KaTeX_Main-Bold.woff2")} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={asset("fonts/KaTeX_Typewriter-Regular.woff2")} as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <!--
impeccable:direction contract 568c1d30
THESIS: A single-page portfolio rendered as a freshly-typeset LaTeX document — Computer Modern serif over typewriter metadata, numbered sections, justified measure, ink on paper — refusing the agency card grid and the hero-metric template for a researcher's body of work.
OWN-WORLD: warm paper field, near-black ink, one muted oxford-blue accent and a sparing annotation red; KaTeX Computer Modern; numbered \section headers with drawn hairline rules; bibliography-style work entries; no cards, no gradients, no chrome.
STORY: A visitor lands on a typeset paper, reads the abstract of who Nithin P is, then moves section to section — Research, Work, Publications, Finance, CV — each list data-driven from editable JSON.
FIRST VIEWPORT: masthead as \maketitle: a hairline that stroke-draws in, name set huge in Computer Modern beside a framed portrait figure, role and affiliation lines in typewriter, abstract in justified measure, and a "Get in touch" button that scrolls to the contact section; fixed running-head nav above with section links and a hairline.
FORM: brief-pinned paper world standing in for assigned grounded direction; seed key 568c1d30.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md.
-->
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <script>
      import "../scripts/reveal.js";
    </script>
  </body>
</html>
