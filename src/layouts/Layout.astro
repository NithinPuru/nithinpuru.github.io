---
import Nav from "../components/Nav.astro";
import "../styles/global.css";

const { title: pageTitle } = Astro.props;
const canonical = Astro.site?.href ?? Astro.url.href;

// Resolves a public/ asset path against the configured base so it stays
// correct both locally (base "/") and when deployed under a base path such as
// a GitHub Pages project site ("/repo/").
const asset = (p) =>
  `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${p.replace(/^\//, "")}`;

const description =
  "Nithin Purushothama — Analog/Mixed-Signal IC Designer. Tapeout experience in SKY130, GF180MCU, IHP SG13G2, UMC 55 nm, TSMC 28 nm. IEEE SSCS Code-a-Chip Travel Grant awardee.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Nithin Purushothama",
  alternateName: "chennakeshavadasa",
  jobTitle: "Analog/Mixed-Signal IC Designer",
  affiliation: {
    "@type": "Organization",
    name: "Omni Design Technologies",
  },
  email: "mailto:nithinpurushothama@gmail.com",
  sameAs: [
    "https://github.com/chennakeshavadasa",
    "https://www.linkedin.com/in/nithin-purushothama-70664727b/",
  ],
  description:
    "Analog/Mixed-Signal IC designer with tapeout experience across SKY130, GF180MCU, IHP SG13G2, UMC 55 nm, and TSMC 28 nm. IEEE SSCS Code-a-Chip Travel Grant awardee (ESSERC 2026).",
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle ?? "Nithin Purushothama — Analog IC Designer"}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Nithin Purushothama" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content="Nithin Purushothama — Analog IC Designer" />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content="Nithin Purushothama — Analog IC Designer" />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={asset("favicon.svg")} />
    <link rel="preload" href={asset("fonts/KaTeX_Main-Regular.woff2")} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={asset("fonts/KaTeX_Main-Bold.woff2")} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={asset("fonts/KaTeX_Typewriter-Regular.woff2")} as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <!--
impeccable:direction contract 568c1d30
THESIS: A single-page portfolio rendered as a freshly-typeset LaTeX document — Computer Modern serif over typewriter metadata, numbered sections, justified measure, ink on paper — refusing the agency card grid and the hero-metric template for a researcher's body of work.
OWN-WORLD: warm paper field, near-black ink, one muted oxford-blue accent and a sparing annotation red; KaTeX Computer Modern; numbered \section headers with drawn hairline rules; bibliography-style work entries; no cards, no gradients, no chrome.
STORY: A visitor lands on a typeset paper, reads the abstract of who Nithin Purushothama is, then moves section to section — Research, Work, Publications, Finance, CV — each list data-driven from editable JSON.
FIRST VIEWPORT: masthead as \maketitle: a hairline that stroke-draws in, name set huge in Computer Modern beside a framed portrait figure, role and affiliation lines in typewriter, abstract in justified measure, and a "Get in touch" button that scrolls to the contact section; fixed running-head nav above with section links and a hairline.
FORM: brief-pinned paper world standing in for assigned grounded direction; seed key 568c1d30.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md.
-->
    <a class="skip-link" href="#main">Skip to content</a>
    <nav class="site-nav">
      <div class="site-nav__bar">
        <div></div>
        <div class="site-nav__links" aria-label="Sections">
          <a href={`${import.meta.env.BASE_URL}#about`}>ABOUT</a>
          <a href={`${import.meta.env.BASE_URL}#experience`}>EXP</a>
          <a href={`${import.meta.env.BASE_URL}#education`}>EDUCATION</a>
          <a href={`${import.meta.env.BASE_URL}#publications`}>PAPERS</a>
          <a href={`${import.meta.env.BASE_URL}#awards`}>AWARDS</a>
          <a href={`${import.meta.env.BASE_URL}#projects`}>PROJECTS</a>
          <a href={`${import.meta.env.BASE_URL}#tapeouts`}>TAPEOUTS</a>
          <a href={`${import.meta.env.BASE_URL}#finance`}>FINANCE</a>
          <a href={`${import.meta.env.BASE_URL}notebook.html`}>NB</a>
        </div>
      </div>
    </nav>
    <main id="main">
      <slot />
    </main>
    <script>
      import "../scripts/reveal.js";
    </script>
  </body>
</html>
